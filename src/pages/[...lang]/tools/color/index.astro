---
import ToolLayout from '../../../../components/ToolLayout.astro';
import IconButton from '../../../../components/IconButton.astro';
import { langOf, toolPaths } from '../../../../i18n/tool-page';
import { s as strings } from '../../../../i18n/tools/color';
import { SCHEMES, KINDS } from '../../../../tools/color/logic';

export const getStaticPaths = toolPaths;
const lang = langOf(Astro.params);
const s = strings[lang] as Record<string, string>;
const tabs = ['contrast', 'palette', 'gradient', 'blind', 'photo', 'pixel'] as const;
const tabName = { contrast: s.tabContrast, palette: s.tabPalette, gradient: s.tabGradient, blind: s.tabBlind, photo: s.tabPhoto, pixel: s.tabPixel };
---
<ToolLayout lang={lang} slug="color">
  <div class="stackv" data-color data-s={JSON.stringify(s)}>
    <div class="card pane">
      <div class="row tabs" role="group">
        {tabs.map((k, i) => <label class="check"><input type="radio" name="tab" value={k} checked={i === 0} /> {tabName[k]}</label>)}
      </div>
    </div>

    <div class="tl two" data-when="contrast">
      <div class="card pane">
        <div class="pick">
          <label>{s.fg}<span class="in"><input name="fg" value="#6a78d1" spellcheck="false" autocomplete="off" /><input type="color" data-pick="fg" value="#6a78d1" aria-label={s.fg} /></span></label>
          <button type="button" class="btn alt" data-swap>{s.swap}</button>
          <label>{s.bg}<span class="in"><input name="bg" value="#0d0f14" spellcheck="false" autocomplete="off" /><input type="color" data-pick="bg" value="#0d0f14" aria-label={s.bg} /></span></label>
        </div>
        <p class="note bad" data-error role="alert" hidden>{s.bad}</p>
        <h2 class="sub">{s.formats}</h2>
        <table><tbody data-formats></tbody></table>
      </div>
      <div class="card pane" aria-live="polite">
        <div class="sample" data-sample><b>{s.sample}</b><span>{s.sample}</span></div>
        <p class="out-big" data-ratio></p>
        <table>
          <thead><tr><th></th><th>{s.normal}</th><th>{s.large}</th></tr></thead>
          <tbody>
            <tr><th>AA</th><td data-g="aaNormal"></td><td data-g="aaLarge"></td></tr>
            <tr><th>AAA</th><td data-g="aaaNormal"></td><td data-g="aaaLarge"></td></tr>
          </tbody>
        </table>
        <p class="meta">{s.note}</p>
      </div>
    </div>

    <div class="tl two" data-when="palette" hidden>
      <div class="card pane">
        <label>{s.base}<span class="in"><input name="base" value="#6a78d1" spellcheck="false" autocomplete="off" /><input type="color" data-pickto="base" value="#6a78d1" aria-label={s.base} /></span></label>
        <label>{s.scheme}<select name="scheme">{SCHEMES.map((k) => <option value={k}>{s[k]}</option>)}</select></label>
        <p class="note bad" data-xerror="palette" role="alert" hidden>{s.noColours}</p>
        <p class="meta">{s.clickCopy}</p>
      </div>
      <div class="card pane">
        <div class="swrow" data-harmony></div>
        <h2 class="sub">{s.shades}</h2>
        <div class="swrow scale" data-shades></div>
      </div>
    </div>

    <div class="tl two" data-when="gradient" hidden>
      <div class="card pane">
        <label>{s.from}<span class="in"><input name="ga" value="#6a78d1" spellcheck="false" autocomplete="off" /><input type="color" data-pickto="ga" value="#6a78d1" aria-label={s.from} /></span></label>
        <label>{s.to}<span class="in"><input name="gb" value="#f4a261" spellcheck="false" autocomplete="off" /><input type="color" data-pickto="gb" value="#f4a261" aria-label={s.to} /></span></label>
        <label><span>{s.stops}: <output name="stepsOut">7</output></span><input name="steps" type="range" min="2" max="12" value="7" aria-label={s.stops} /></label>
        <p class="note bad" data-xerror="gradient" role="alert" hidden>{s.noColours}</p>
      </div>
      <div class="card pane">
        <div class="gradbar" data-gradbar></div>
        <div class="swrow" data-gradstops></div>
        <h2 class="sub">{s.css}</h2>
        <pre class="mono" data-css></pre>
        <div class="actions"><IconButton icon="copy" label={s.copy} data-copycss /></div>
      </div>
    </div>

    <div class="tl two" data-when="blind" hidden>
      <div class="card pane">
        <label>{s.list}<textarea name="list" rows="8" spellcheck="false">#e63946
#2a9d8f
#f4a261
#264653
#6a78d1</textarea></label>
        <p class="note bad" data-xerror="blind" role="alert" hidden>{s.noColours}</p>
        <p class="meta">{s.clickCopy}</p>
        <p class="meta">{s.blindNote}</p>
      </div>
      <div class="card pane">
        <div class="blind" data-blind></div>
        <div class="legend meta" data-legend>
          <span>{s.original}</span>{KINDS.map((k) => <span>{s[k]}</span>)}
        </div>
      </div>
    </div>
    <div class="tl" data-when="photo" hidden>
      <div class="drop card" data-drop>
        <p class="big">{s.pDrop}</p>
        <p class="meta">{s.pOr}</p>
        <label class="btn pickbtn">{s.pBrowse}<input type="file" accept="image/*" class="sr-only" data-file /></label>
        <p class="meta">{s.pHint}</p>
      </div>
      <p class="note bad" role="alert" data-error hidden></p>
      <div class="work" data-work hidden>
        <div class="card pane">
          <img class="pic" data-img alt={s.pAlt} />
          <label><span>{s.pCount} <output data-count></output></span><input type="range" aria-label={s.pCount} name="pcount" min="2" max="12" value="6" /></label>
          <div class="sws" data-swatches></div>
          <p class="meta">{s.pSw}</p>
        </div>
        <div class="card pane">
          <div class="row">
            <label>{s.pExp}<select name="pkind"><option value="css">{s.pCssVars}</option><option value="json">{s.pJson}</option><option value="list">{s.pPlain}</option></select></label>
            <IconButton icon="copy" label={s.copy} alt={false} data-copy />
            <button type="button" class="btn alt" data-other>{s.pOther}</button>
          </div>
          <textarea name="pexport" class="mono" rows="8" readonly spellcheck="false"></textarea>
        </div>
      </div>
    </div>
    <div class="tl" data-when="pixel" hidden>
      <div class="drop card" data-pdrop>
        <p class="big">{s.pDrop}</p>
        <p class="meta">{s.pOr}</p>
        <label class="btn pickbtn">{s.pBrowse}<input type="file" accept="image/*" class="sr-only" data-pfile /></label>
        <p class="meta">{s.xHint}</p>
      </div>
      <p class="note bad" role="alert" data-perror hidden></p>
      <div class="work" data-pwork hidden>
        <div class="card pane">
          <div class="stage" data-pstage>
            <canvas class="pcanvas" data-pcanvas tabindex="0" role="img" aria-label={s.xAlt}></canvas>
            <canvas class="loupe" data-ploupe width="120" height="120" hidden aria-hidden="true"></canvas>
          </div>
          <p class="meta">{s.xKeys}</p>
        </div>
        <div class="card pane">
          <div class="cur"><span class="pchip" data-pchip></span><div class="pvals" data-pvalues></div></div>
          <p class="meta">{s.xAt} <span class="mono" data-pxy></span></p>
          <div data-psaved-wrap hidden>
            <h2 class="sub">{s.xSaved}</h2>
            <div class="sws" data-psaved></div>
          </div>
          <div class="actions"><button type="button" class="btn alt" data-pother>{s.pOther}</button></div>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>
<script>
  import '../../../../tools/color/color.ts';
</script>
<style>
  .sub { margin: 4px 0 0; font-family: var(--font); font-size: .95rem; font-weight: 600; letter-spacing: 0; }
  .pick { display: grid; gap: 12px; }
  .in { display: flex; gap: 8px; }
  .in input[type='color'] { flex: none; width: 46px; height: 40px; padding: 2px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface-2); cursor: pointer; }
  .pick .btn { justify-self: start; }
  .sample { display: grid; gap: 2px; padding: 22px; border: 1px solid var(--line); border-radius: var(--radius-sm); }
  .sample b { font-size: 1.5rem; line-height: 1.2; }
  .ok { color: #4fae7b; font-weight: 600; }
  .no { color: #d65a5a; font-weight: 600; }
  button.val { padding: 0; border: 0; background: none; color: inherit; font: inherit; cursor: copy; text-align: left; }
  button.val:hover { color: var(--accent-ink); }
  .stackv { display: grid; gap: var(--gap, 20px); }
  .swrow { display: flex; flex-wrap: wrap; gap: 8px; }
  :global(.swrow .sw) { flex: 1 1 64px; min-height: 56px; padding: 6px; border: 1px solid var(--line); border-radius: var(--radius-sm); font: .78rem/1.2 var(--mono, ui-monospace, monospace); cursor: copy; display: flex; align-items: end; }
  .scale :global(.sw) { flex: 1 1 48px; min-height: 64px; }
  .gradbar { height: 64px; border-radius: var(--radius-sm); border: 1px solid var(--line); }
  .blind { display: grid; gap: 8px; }
  :global(.blind .brow) { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
  :global(.blind .sw) { min-height: 48px; padding: 4px; border: 1px solid var(--line); border-radius: var(--radius-sm); font: .7rem/1.2 var(--mono, ui-monospace, monospace); cursor: copy; display: flex; align-items: end; }
  .drop { display: grid; justify-items: center; gap: 8px; padding: clamp(24px, 4vw, 40px); text-align: center; border-style: dashed; }
  .drop.over { border-color: var(--accent); }
  .big { margin: 0; font-size: 1.15rem; }
  .pickbtn { cursor: pointer; }
  .work { display: grid; gap: 20px; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: start; }
  @media (max-width: 800px) { .work { grid-template-columns: minmax(0, 1fr); } }
  .pic { display: block; max-width: 100%; max-height: 340px; justify-self: center; border-radius: 6px; }
  :global(.sws) { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 8px; }
  :global(.sws .sw) { display: grid; gap: 2px; align-content: end; min-height: 84px; padding: 10px 12px; border: 1px solid #8884; border-radius: 8px; text-align: left; font: inherit; cursor: pointer; }
  :global(.sws .sw b) { font: 600 .95rem ui-monospace, 'Cascadia Mono', Consolas, monospace; }
  :global(.sws .sw span) { font-size: .8rem; opacity: .85; }
  :global(.sws .sw:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .legend { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; font-size: .74rem; }
  .stage { position: relative; justify-self: center; line-height: 0; max-width: 100%; }
  .pcanvas { display: block; max-width: 100%; max-height: 70vh; width: auto; height: auto; cursor: crosshair; touch-action: none; border: 1px solid var(--line); border-radius: 6px; }
  .pcanvas:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .loupe { position: absolute; width: 120px; height: 120px; border: 3px solid #fff; border-radius: 50%; box-shadow: 0 0 0 1px #000, 0 4px 16px #0008; pointer-events: none; image-rendering: pixelated; }
  .loupe[hidden] { display: none; }
  .cur { display: flex; gap: 16px; align-items: center; }
  .pchip { flex: none; width: 72px; height: 72px; border: 1px solid var(--line); border-radius: 12px; }
  .pvals { display: grid; gap: 2px; min-width: 0; }
  .pvals :global(div) { display: flex; gap: 10px; align-items: baseline; font-size: .9rem; }
  .pvals :global(div > span) { width: 3.2em; color: var(--muted); }
  .pvals :global(.val) { overflow-wrap: anywhere; }
</style>
