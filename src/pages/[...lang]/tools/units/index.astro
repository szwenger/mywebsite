---
import ToolLayout from '../../../../components/ToolLayout.astro';
import { LANGS, type Lang } from '../../../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l === 'en' ? undefined : l } }));
}
const lang = (Astro.params.lang ?? 'en') as Lang;
// `names` only needs the units the browser cannot name itself (Intl covers the common ones in every language).
const s = {
  en: {
    locale: 'en', value: 'Value', from: 'From', to: 'To', swap: 'Swap units', all: 'In every unit', hint: 'Click a row to make it the target and copy its value.', copied: '✓',
    cats: { length: 'Length', mass: 'Mass', volume: 'Volume', temperature: 'Temperature', speed: 'Speed', area: 'Area', time: 'Time', data: 'Data', pressure: 'Pressure', energy: 'Energy', power: 'Power', angle: 'Angle', fuel: 'Fuel economy' },
    names: {},
  },
  de: {
    locale: 'de', value: 'Wert', from: 'Von', to: 'Nach', swap: 'Einheiten tauschen', all: 'In jeder Einheit', hint: 'Klick auf eine Zeile macht sie zum Ziel und kopiert den Wert.', copied: '✓',
    cats: { length: 'Länge', mass: 'Masse', volume: 'Volumen', temperature: 'Temperatur', speed: 'Geschwindigkeit', area: 'Fläche', time: 'Zeit', data: 'Daten', pressure: 'Druck', energy: 'Energie', power: 'Leistung', angle: 'Winkel', fuel: 'Verbrauch' },
    names: { 'µm': 'Mikrometer', nmi: 'Seemeile', mg: 'Milligramm', t: 'Tonne', 'm³': 'Kubikmeter', qt: 'US-Quart', pt: 'US-Pint', cup: 'US-Cup', tbsp: 'US-Esslöffel', tsp: 'US-Teelöffel', 'imp gal': 'Imperiale Gallone', K: 'Kelvin', 'm/s': 'Meter pro Sekunde', kn: 'Knoten', 'ft/s': 'Fuß pro Sekunde', 'm²': 'Quadratmeter', 'km²': 'Quadratkilometer', 'cm²': 'Quadratzentimeter', 'ft²': 'Quadratfuß', 'in²': 'Quadratzoll', 'yd²': 'Quadratyard', 'mi²': 'Quadratmeile', d: 'Tag', wk: 'Woche', mo: 'Monat (Durchschnitt)', yr: 'Jahr (Durchschnitt)', kB: 'Kilobyte (1000)', MB: 'Megabyte (1000²)', GB: 'Gigabyte (1000³)', TB: 'Terabyte (1000⁴)', PB: 'Petabyte (1000⁵)', KiB: 'Kibibyte (1024)', MiB: 'Mebibyte (1024²)', GiB: 'Gibibyte (1024³)', TiB: 'Tebibyte (1024⁴)', Pa: 'Pascal', kPa: 'Kilopascal', bar: 'Bar', psi: 'Pfund pro Quadratzoll', atm: 'Physikalische Atmosphäre', mmHg: 'Millimeter Quecksilbersäule', J: 'Joule', kJ: 'Kilojoule', cal: 'Kalorie', kcal: 'Kilokalorie', Wh: 'Wattstunde', kWh: 'Kilowattstunde', BTU: 'British thermal unit', W: 'Watt', kW: 'Kilowatt', hp: 'Pferdestärke (mechanisch)', PS: 'Pferdestärke (metrisch)', rad: 'Radiant', grad: 'Gon', turn: 'Volle Drehung', 'L/100km': 'Liter pro 100 km', mpg: 'Meilen pro US-Gallone', 'mpg UK': 'Meilen pro imperialer Gallone', 'km/L': 'Kilometer pro Liter' },
  },
  ru: {
    locale: 'ru', value: 'Значение', from: 'Из', to: 'В', swap: 'Поменять единицы', all: 'Во всех единицах', hint: 'Щелчок по строке делает её целевой единицей и копирует значение.', copied: '✓',
    cats: { length: 'Длина', mass: 'Масса', volume: 'Объём', temperature: 'Температура', speed: 'Скорость', area: 'Площадь', time: 'Время', data: 'Данные', pressure: 'Давление', energy: 'Энергия', power: 'Мощность', angle: 'Угол', fuel: 'Расход топлива' },
    names: { 'µm': 'Микрометр', nmi: 'Морская миля', mg: 'Миллиграмм', t: 'Тонна', 'm³': 'Кубический метр', qt: 'Кварта США', pt: 'Пинта США', cup: 'Стакан США', tbsp: 'Столовая ложка США', tsp: 'Чайная ложка США', 'imp gal': 'Британский галлон', K: 'Кельвин', 'm/s': 'Метр в секунду', kn: 'Узел', 'ft/s': 'Фут в секунду', 'm²': 'Квадратный метр', 'km²': 'Квадратный километр', 'cm²': 'Квадратный сантиметр', 'ft²': 'Квадратный фут', 'in²': 'Квадратный дюйм', 'yd²': 'Квадратный ярд', 'mi²': 'Квадратная миля', d: 'Сутки', wk: 'Неделя', mo: 'Месяц (в среднем)', yr: 'Год (в среднем)', kB: 'Килобайт (1000)', MB: 'Мегабайт (1000²)', GB: 'Гигабайт (1000³)', TB: 'Терабайт (1000⁴)', PB: 'Петабайт (1000⁵)', KiB: 'Кибибайт (1024)', MiB: 'Мебибайт (1024²)', GiB: 'Гибибайт (1024³)', TiB: 'Тебибайт (1024⁴)', Pa: 'Паскаль', kPa: 'Килопаскаль', bar: 'Бар', psi: 'Фунт на квадратный дюйм', atm: 'Атмосфера', mmHg: 'Миллиметр ртутного столба', J: 'Джоуль', kJ: 'Килоджоуль', cal: 'Калория', kcal: 'Килокалория', Wh: 'Ватт-час', kWh: 'Киловатт-час', BTU: 'Британская тепловая единица', W: 'Ватт', kW: 'Киловатт', hp: 'Лошадиная сила (механическая)', PS: 'Лошадиная сила (метрическая)', rad: 'Радиан', grad: 'Град', turn: 'Полный оборот', 'L/100km': 'Литров на 100 км', mpg: 'Миль на галлон США', 'mpg UK': 'Миль на британский галлон', 'km/L': 'Километров на литр' },
  },
}[lang];
---
<ToolLayout lang={lang} slug="units">
  <div class="tl units" data-units data-s={JSON.stringify(s)}>
    <div class="card pane">
      <div class="chips" data-cats></div>
      <div class="row">
        <label>{s.value}<input name="value" class="mono big" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
        <label>{s.from}<select name="from"></select></label>
        <button type="button" class="btn alt swap" data-swap aria-label={s.swap} title={s.swap}>⇄</button>
        <label>{s.to}<select name="to"></select></label>
      </div>
      <p class="out-big" data-out aria-live="polite"></p>
    </div>
    <div class="card pane">
      <h2 class="h">{s.all}</h2>
      <div class="table" data-table></div>
      <p class="meta">{s.hint}</p>
    </div>
  </div>
</ToolLayout>
<script>
  import '../../../../tools/units/units.ts';
</script>
<style>
  .h { margin: 0; font: 600 1rem/1.3 var(--display); }
  .big { font-size: 1.15rem; }
  .swap { align-self: end; padding: 9px 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  :global(.units .chip) { padding: 6px 14px; border: 1px solid var(--line); border-radius: 99px; background: transparent; color: var(--muted); font: inherit; font-size: .88rem; cursor: pointer; }
  :global(.units .chip[aria-pressed='true']) { background: var(--surface-2); color: var(--fg); box-shadow: inset 0 -2px 0 var(--accent); }
  :global(.units .table) { display: grid; }
  :global(.units .urow) { display: flex; justify-content: space-between; gap: 16px; padding: 8px 10px; border: 0; border-bottom: 1px solid var(--line); background: none; color: var(--fg); font: inherit; font-size: .92rem; text-align: left; cursor: pointer; }
  :global(.units .urow:hover) { background: var(--surface-2); }
  :global(.units .urow[aria-current='true']) { box-shadow: inset 3px 0 0 var(--accent); }
  :global(.units .uv) { font-variant-numeric: tabular-nums; font-weight: 600; text-align: right; overflow-wrap: anywhere; }
  :global(.units .un) { color: var(--muted); }
</style>
