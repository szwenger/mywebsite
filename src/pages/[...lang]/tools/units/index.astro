---
import ToolLayout from '../../../../components/ToolLayout.astro';
import { langOf, toolPaths } from '../../../../i18n/tool-page';
import { s as strings } from '../../../../i18n/tools/units';

export const getStaticPaths = toolPaths;
const lang = langOf(Astro.params);
const s = strings[lang];
---
<ToolLayout lang={lang} slug="units">
  <div class="tl units" data-units data-s={JSON.stringify(s)}>
    <div class="card pane">
      <div class="chips" data-cats></div>
      <div class="row">
        <label>{s.value}<input name="value" class="mono big" inputmode="decimal" spellcheck="false" autocomplete="off" /></label>
        <label>{s.from}<select name="from"></select></label>
        <button type="button" class="btn alt swap" data-swap aria-label={s.swap} title={s.swap}>⇄</button>
        <label>{s.to}<select name="to"></select></label>
      </div>
      <div class="row" data-ctx hidden>
        <label>{s.rem}<input name="rem" class="mono" inputmode="decimal" value="16" /></label>
        <label>{s.ppi}<input name="ppi" class="mono" inputmode="decimal" value="96" /></label>
      </div>
      <p class="out-big" data-out aria-live="polite"></p>
    </div>
    <div class="card pane">
      <h2 class="h">{s.all}</h2>
      <div class="table" data-table></div>
      <p class="meta">{s.hint}</p>
      <p class="meta" data-hint="screen" hidden>{s.hintScreen}</p>
      <p class="meta" data-hint="bases" hidden>{s.hintBase}</p>
    </div>
  </div>
</ToolLayout>
<script>
  import '../../../../tools/units/units.ts';
</script>
<style>
  .h { margin: 0; font: 600 1rem/1.3 var(--display); }
  .big { font-size: 1.15rem; }
  .swap { align-self: end; padding: 9px 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  :global(.units .chip) { padding: 6px 14px; border: 1px solid var(--line); border-radius: 99px; background: transparent; color: var(--muted); font: inherit; font-size: .88rem; cursor: pointer; }
  :global(.units .chip[aria-pressed='true']) { background: var(--surface-2); color: var(--fg); box-shadow: inset 0 -2px 0 var(--accent); }
  :global(.units .table) { display: grid; }
  :global(.units .urow) { display: flex; justify-content: space-between; gap: 16px; padding: 8px 10px; border: 0; border-bottom: 1px solid var(--line); background: none; color: var(--fg); font: inherit; font-size: .92rem; text-align: left; cursor: pointer; }
  :global(.units .urow:hover) { background: var(--surface-2); }
  :global(.units .urow[aria-current='true']) { box-shadow: inset 3px 0 0 var(--accent); }
  :global(.units .uv) { font-variant-numeric: tabular-nums; font-weight: 600; text-align: right; overflow-wrap: anywhere; }
  :global(.units .un) { color: var(--muted); }
</style>
