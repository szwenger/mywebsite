    tag_learn: 'Учим клавиши', tag_words: 'Слова', tag_symbols: 'Символы', tag_text: 'Текст', tag_precision: 'Точность', tag_sprint: 'Спринт', tag_endurance: 'Выносливость',
    levelN: 'Уровень {n}', goal: 'Цель: {wpm} WPM при точности {acc}%', bestOf: 'Лучшее: {wpm} WPM, {acc}%', locked: 'Закрыто: сначала получите звезду на уровне {n}', unlockAll: 'Открыть все уровни',
    levelsHint: 'Для звезды нужны скорость и точность. Для двух и трёх звёзд скорость выше на 20% и 40%.',
    hint: 'Нажмите сюда и печатайте', restart: 'Заново (Esc)', back: 'Назад', showKeys: 'Показывать клавиатуру', time: 'Время', speed: 'Скорость', accuracy: 'Точность', textLabel: 'Текст для набора',
    resNet: 'Чистая скорость', resRaw: 'Общая скорость', resAcc: 'Точность', resErr: 'Ошибки', resTime: 'Время', retry: 'Ещё раз', next: 'Следующий уровень',
    passed: 'Уровень пройден.', failed: 'Пока нет. Нужно {wpm} WPM при точности {acc}%.', newBest: 'Новый личный рекорд.', tooShort: 'Слишком коротко для зачёта. Наберите хотя бы 10 символов.',
    resHelp: 'Чистая скорость учитывает только верные символы. Общая считает каждую нажатую клавишу.',
    runsT: 'Попытки', bestT: 'Лучшая скорость', avgT: 'Среднее, последние 10', accT: 'Точность, последние 10', timeT: 'Время набора', unitMin: 'мин',
    trendH: 'Скорость со временем', histH: 'Как распределяются ваши попытки', calH: 'Календарь занятий', kbH: 'Клавиатура', weakH: 'Клавиши с ошибками', slowH: 'Самые медленные клавиши', lvH: 'Прогресс по уровням',
    kbSpeed: 'Скорость', kbErr: 'Ошибки', empty: 'Пока нет попыток. Закончите тест, и здесь появится статистика.', needMore: 'Пока мало данных (нужно 8 нажатий на клавишу).',
    lvSum: 'Пройдено уровней: {done} из 50, звёзд: {stars} из 150.', clear: 'Удалить мои данные', clearSure: 'Нажмите ещё раз, чтобы удалить всё', storeNote: 'Статистика хранится в этом браузере (localStorage). Ничего не отправляется.', storeOff: 'Браузер блокирует локальное хранилище, поэтому между визитами ничего не сохраняется.',
    backupH: 'Резервная копия', backupHelp: 'Сохраните результаты в файл, чтобы не потерять их или перенести на другое устройство. Импорт добавляет данные к имеющимся и ничего не удаляет.', export: 'Экспорт данных', import: 'Импорт данных', imported: 'Импортировано: новых попыток {n}. Уровни и статистика клавиш объединены.', importBad: 'Этот файл не является экспортом тренажёра.', exportEmpty: 'Пока нечего экспортировать.',
    wpm: 'WPM', net: 'Чистая', raw: 'Общая', second: 'Секунда {n}', mistakes: 'ошибок: {n}', mistakesLegend: 'Ошибки', runChart: 'Скорость по секундам этой попытки', trend: 'Скорость каждой попытки', eachRun: 'Каждая попытка', avg10: 'Среднее за последние 10',
    hist: 'Число попыток по диапазонам скорости', runs: 'Попытки', runsN: 'попыток: {n}', calendar: 'Минуты набора по дням', minutes: '{n} мин', noTyping: 'без набора', days: 'Пн,Вт,Ср,Чт,Пт,Сб,Вс', less: 'Меньше', more: 'Больше',
    acc: 'точность', noData: 'данных пока нет', mistakesWord: 'ошибок', pressed: 'нажатий: {n}', slowKey: 'Медленно', fastKey: 'Быстро', fewMistakes: 'Мало ошибок', manyMistakes: 'Много ошибок',
  },
}[lang];
const tiers = [1, 2, 3, 4, 5] as const;
const limits = [['15s', 15], ['30s', 30], ['60s', 60], ['120s', 120], ['25', 0], ['50', 0], ['100', 0]] as const;
const fmt = (tpl: string, n: number | string) => tpl.replace('{n}', String(n));
const kinds = ['words', 'long', 'caps', 'punct', 'numbers', 'sentences', 'code', 'letters'] as const;
---
<ToolLayout lang={lang} slug="typing">
  <div class="tt tl" data-typing data-lang={lang} data-s={JSON.stringify(s)}>
    <p class="note bad" data-nostore hidden>{s.storeOff}</p>

    <div class="tt-bar">
      <div class="tt-tabs" role="tablist" aria-label={s.tabs}>
        <button type="button" role="tab" data-tab="quick" aria-selected="true">{s.tabQuick}</button>
        <button type="button" role="tab" data-tab="levels" aria-selected="false">{s.tabLevels}</button>
        <button type="button" role="tab" data-tab="stats" aria-selected="false">{s.tabStats}</button>
      </div>
      <label class="tt-lang">{s.language}
        <select name="lang"><option value="en">English</option><option value="de">Deutsch</option><option value="ru">Русский</option></select>
      </label>
    </div>

    <section class="card pane" data-view="quick">
      <div class="row">
        <label>{s.kind}<select name="kind">{kinds.map((k) => <option value={k}>{s[`kind_${k}`]}</option>)}</select></label>
        <label>{s.limit}<select name="limit">{limits.map(([v, n]) => <option value={v}>{n ? fmt(s.secondsN, n) : fmt(s.wordsN, v)}</option>)}</select></label>
      </div>
      <p class="meta">{s.quickHint}</p>
      <div class="actions"><button type="button" class="btn" data-start>{s.start}</button></div>
    </section>

    <section class="card pane" data-view="levels" hidden>
      <div class="row">
        <label class="check"><input type="checkbox" name="all" />{s.unlockAll}</label>
        <strong class="tt-stars" data-star-total></strong>
      </div>
      <p class="meta">{s.levelsHint}</p>
      {tiers.map((t) => (
        <div class="tt-tier">
          <h2>{t}. {s[`t${t}`]}</h2>
          <p class="meta">{s[`t${t}d`]}</p>
          <div class="tt-grid" data-tier={t}></div>
        </div>
      ))}
    </section>

    <section class="card pane" data-view="stats" hidden>
      <p class="meta" data-empty>{s.empty}</p>
      <div class="tt-stats" data-stats hidden>
        <div class="tt-tiles" data-tiles></div>
        <div class="tt-panel"><h2>{s.trendH}</h2><div data-trend></div></div>
        <div class="tt-panel"><h2>{s.histH}</h2><div data-hist></div></div>
        <div class="tt-panel"><h2>{s.calH}</h2><div data-cal></div></div>
        <div class="tt-panel">
          <h2>{s.kbH} <small data-stat-lang></small></h2>
          <div class="tt-seg" role="group" aria-label={s.kbH}>
            <button type="button" data-metric="speed" aria-pressed="true">{s.kbSpeed}</button>
            <button type="button" data-metric="errors" aria-pressed="false">{s.kbErr}</button>
          </div>
          <div data-kbmap></div>
        </div>
        <div class="tt-two">
          <div class="tt-panel"><h2>{s.weakH}</h2><ul class="tt-keys" data-weak></ul></div>
          <div class="tt-panel"><h2>{s.slowH}</h2><ul class="tt-keys" data-slow></ul></div>
        </div>
        <div class="tt-panel"><h2>{s.lvH}</h2><p class="meta" data-lvsum></p></div>
        <p class="meta">{s.storeNote}</p>
        <div class="actions"><button type="button" class="btn alt" data-wipe>{s.clear}</button></div>
      </div>
      <div class="tt-panel tt-backup">
        <h2>{s.backupH}</h2>
        <p class="meta">{s.backupHelp}</p>
        <div class="actions">
          <button type="button" class="btn alt" data-export>{s.export}</button>
          <button type="button" class="btn alt" data-import>{s.import}</button>
          <input type="file" accept=".json,application/json" data-import-file hidden />
        </div>
        <p class="note" data-backup-msg role="status" hidden></p>
      </div>
    </section>

    <section class="card pane" data-view="play" hidden>
      <div class="tt-head">
        <div><strong data-title></strong><p class="meta" data-goal></p></div>
        <div class="actions">
          <button type="button" class="btn alt" data-restart>{s.restart}</button>
          <button type="button" class="btn alt" data-back>{s.back}</button>
        </div>
      </div>
      <div class="tt-live" data-live-row>
        <div><small>{s.time}</small><b data-live="time">0</b></div>
        <div><small>{s.speed}</small><b data-live="wpm">0</b></div>
        <div><small>{s.accuracy}</small><b data-live="acc">100%</b></div>
      </div>
      <div class="tt-text mono" data-text>
        <div class="tt-inner" data-text-inner></div>
        <input class="tt-in" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label={s.textLabel} />
        <button type="button" class="tt-hint" data-hint>{s.hint}</button>
      </div>
      <div class="tt-kb" data-kb></div>
      <label class="check" data-keys-label><input type="checkbox" name="keys" checked />{s.showKeys}</label>

      <div class="tt-result" data-result hidden>
        <div class="tt-big">
          <div><small>{s.resNet}</small><b data-r="wpm">0</b><em>{s.wpm}</em></div>
          <div><small>{s.resAcc}</small><b data-r="acc">0</b></div>
          <div><small>{s.resRaw}</small><b data-r="raw">0</b></div>
          <div><small>{s.resErr}</small><b data-r="err">0</b></div>
          <div><small>{s.resTime}</small><b data-r="time">0</b></div>
        </div>
        <p class="note" data-verdict hidden></p>
        <div data-run-chart></div>
        <p class="meta">{s.resHelp}</p>
        <div class="actions">
          <button type="button" class="btn" data-next hidden>{s.next}</button>
          <button type="button" class="btn alt" data-retry>{s.retry}</button>
        </div>
      </div>
    </section>
    <div class="tt-tipbox" data-tip-box role="tooltip" hidden></div>
  </div>
</ToolLayout>
<script>
  import '../../../../tools/typing/typing.ts';
</script>
<style is:global>
  .tt { position: relative; --tt-1: #2a78d6; --tt-2: #eb6834; --tt-err: #e34948; --tt-ink: #fff; }
  html[data-theme='dark'] .tt { --tt-1: #3987e5; --tt-2: #d95926; --tt-err: #e66767; }
  .tt [hidden] { display: none !important; }

  .tt-bar { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: end; justify-content: space-between; }
  .tt-tabs { display: inline-flex; gap: 4px; padding: 4px; border: 1px solid var(--line); border-radius: 99px; background: var(--surface); }
  .tt-tabs button { padding: 8px 16px; border: 0; border-radius: 99px; background: none; color: var(--muted); font: inherit; font-size: .92rem; font-weight: 500; cursor: pointer; }
  .tt-tabs button:hover { color: var(--fg); }
  .tt-tabs button[aria-selected='true'] { background: var(--accent-strong); color: #fff; }
  .tt-lang { min-width: 170px; }
  .tt-stars { font-variant-numeric: tabular-nums; color: var(--accent-ink); }

  .tt-tier h2 { margin: 6px 0 0; font: 600 1rem/1.3 var(--display); letter-spacing: -.01em; }
  .tt-tier .meta { margin: 2px 0 10px; }
  .tt-grid { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 8px; }
  @media (max-width: 860px) { .tt-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .tt-grid .lv { display: grid; justify-items: center; gap: 2px; padding: 10px 4px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface-2); color: var(--fg); font: inherit; cursor: pointer; transition: border-color .15s, transform .15s var(--ease); }
  .tt-grid .lv b { font: 600 1.05rem/1.2 var(--display); }
  .tt-grid .lv .st { font-size: .85rem; letter-spacing: 1px; color: var(--muted); }
  .tt-grid .lv.got .st { color: var(--tt-2); }
  .tt-grid .lv small { color: var(--muted); font-size: .72rem; display: inline-flex; align-items: center; gap: 4px; min-height: 1.2em; }
  .tt-grid .lv:not(:disabled):hover { border-color: var(--accent); transform: translateY(-2px); }
  .tt-grid .lv:disabled { opacity: .5; cursor: not-allowed; }

  .tt-head { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: start; justify-content: space-between; }
  .tt-head .meta { margin: 2px 0 0; }
  .tt-live { display: flex; gap: 28px; }
  .tt-live small, .tt-big small, .tt-tiles small { display: block; color: var(--muted); font-size: .8rem; }
