    acc: 'Genauigkeit', noData: 'noch keine Daten', mistakesWord: 'Fehler', pressed: '{n} Anschläge', slowKey: 'Langsam', fastKey: 'Schnell', fewMistakes: 'Wenige Fehler', manyMistakes: 'Viele Fehler',
  },
  ru: {
    locale: 'ru', tabQuick: 'Быстрый старт', tabLevels: 'Уровни', tabStats: 'Статистика', tabs: 'Клавиатурный тренажёр', language: 'Язык набора', kind: 'Текст', limit: 'Длина', start: 'Старт',
    secondsN: '{n} с', wordsN: '{n} слов',
    kind_words: 'Частые слова', kind_long: 'Длинные слова', kind_caps: 'Заглавные буквы', kind_punct: 'Знаки препинания', kind_numbers: 'Числа', kind_sentences: 'Предложения', kind_code: 'Код', kind_letters: 'Упражнения на буквы',
    quickHint: 'Время идёт с первой нажатой клавиши. Backspace исправляет ошибку, Esc начинает заново.',
