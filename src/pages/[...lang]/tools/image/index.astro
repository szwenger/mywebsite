---
import ToolLayout from '../../../../components/ToolLayout.astro';
import ImageConvert from '../../../../components/ImageConvert.astro';
import { LANGS, type Lang } from '../../../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l === 'en' ? undefined : l } }));
}
const lang = (Astro.params.lang ?? 'en') as Lang;
const s = {
  en: {
    drop: 'Drop images here', or: 'or', browse: 'Choose images',
    hint: 'PNG, JPEG, WebP, GIF, BMP and HEIC (iPhone photos). Animated GIFs keep only their first frame. Transparent areas become white in JPG.',
    format: 'Format', quality: 'Quality', maxW: 'Max width (px)', maxH: 'Max height (px)', maxHint: 'Optional. Images are only ever made smaller, never enlarged.',
    download: 'Download', all: 'Download all', remove: 'Remove', clear: 'Clear all', list: 'Files', working: 'Converting…', kb: 'KB', mb: 'MB',
    badType: 'Not a PNG, JPEG, WebP, GIF, BMP or HEIC image.', failed: 'This image could not be read.',
    unsupported: 'This browser cannot export {fmt}. Choose another format.',
    tooBig: 'Too large to convert in the browser. Set a max width or height.',
  },
  de: {
    drop: 'Bilder hier ablegen', or: 'oder', browse: 'Bilder wählen',
    hint: 'PNG, JPEG, WebP, GIF, BMP und HEIC (iPhone-Fotos). Animierte GIFs behalten nur das erste Bild. Transparente Bereiche werden in JPG weiß.',
    format: 'Format', quality: 'Qualität', maxW: 'Max. Breite (px)', maxH: 'Max. Höhe (px)', maxHint: 'Optional. Bilder werden nur verkleinert, nie vergrößert.',
    download: 'Herunterladen', all: 'Alle herunterladen', remove: 'Entfernen', clear: 'Alle entfernen', list: 'Dateien', working: 'Wird umgewandelt…', kb: 'KB', mb: 'MB',
    badType: 'Kein PNG-, JPEG-, WebP-, GIF-, BMP- oder HEIC-Bild.', failed: 'Dieses Bild konnte nicht gelesen werden.',
    unsupported: 'Dieser Browser kann {fmt} nicht exportieren. Wähle ein anderes Format.',
    tooBig: 'Zu groß für die Umwandlung im Browser. Setze eine maximale Breite oder Höhe.',
  },
  ru: {
    drop: 'Перетащите сюда изображения', or: 'или', browse: 'Выбрать изображения',
    hint: 'PNG, JPEG, WebP, GIF, BMP и HEIC (фото с iPhone). У анимированных GIF сохраняется только первый кадр. Прозрачные области в JPG становятся белыми.',
    format: 'Формат', quality: 'Качество', maxW: 'Макс. ширина (px)', maxH: 'Макс. высота (px)', maxHint: 'Необязательно. Изображения только уменьшаются, но не увеличиваются.',
    download: 'Скачать', all: 'Скачать все', remove: 'Убрать', clear: 'Убрать все', list: 'Файлы', working: 'Преобразование…', kb: 'КБ', mb: 'МБ',
    badType: 'Это не изображение PNG, JPEG, WebP, GIF, BMP или HEIC.', failed: 'Не удалось прочитать это изображение.',
    unsupported: 'Этот браузер не умеет сохранять в {fmt}. Выберите другой формат.',
    tooBig: 'Слишком большое изображение для преобразования в браузере. Укажите максимальную ширину или высоту.',
  },
}[lang];
---
<ToolLayout lang={lang} slug="image">
  <ImageConvert s={s} heic accept="image/png,image/jpeg,image/webp,image/gif,image/bmp,image/heic,image/heif,.heic,.heif" />
</ToolLayout>
