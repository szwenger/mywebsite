---
import ToolLayout from '../../../../components/ToolLayout.astro';
import IconButton from '../../../../components/IconButton.astro';
import { langOf, toolPaths } from '../../../../i18n/tool-page';
import { s as strings } from '../../../../i18n/tools/checksum';
import { ALGOS, LABEL } from '../../../../tools/checksum/logic';

export const getStaticPaths = toolPaths;
const lang = langOf(Astro.params);
const s = strings[lang];
---
<ToolLayout lang={lang} slug="checksum">
  <div class="tl" data-checksum data-s={JSON.stringify(s)}>
    <div class="card pane">
      <div class="row tabs" role="group">
        <label class="check"><input type="radio" name="mode" value="text" checked /> {s.text}</label>
        <label class="check"><input type="radio" name="mode" value="file" /> {s.file}</label>
      </div>
      <label data-when="text">{s.input}<textarea name="text" rows="5" spellcheck="false"></textarea><span class="meta">{s.inputHint}</span></label>
      <label class="drop" data-when="file" data-drop hidden>
        <span>{s.drop}</span>
        <span class="meta" data-file></span>
        <input type="file" data-input />
      </label>
      <div class="row" role="group" aria-label={s.algos}>
        {ALGOS.map((a) => <label class="check"><input type="checkbox" name="algo" value={a} checked /> {LABEL[a]}</label>)}
      </div>
      <label>{s.expected}<input name="expected" class="mono" autocomplete="off" spellcheck="false" placeholder={s.placeholder} /></label>
      <progress max="1" value="0" data-bar hidden></progress>
      <p class="meta" data-status role="status"></p>
      <div class="actions"><button type="button" class="btn alt" data-cancel hidden>{s.cancel}</button></div>
    </div>
    <div class="card pane" data-result hidden aria-label={s.results}>
      {ALGOS.map((a) => (
        <div class="hrow" data-row={a} hidden>
          <span class="meta">{LABEL[a]}</span>
          <pre data-hash={a}></pre>
          <IconButton icon="copy" label={`${s.copy} ${LABEL[a]}`} data-copy={a} />
        </div>
      ))}
      <p class="note" data-verdict hidden role="status"></p>
    </div>
    <p class="meta">{s.note}</p>
  </div>
</ToolLayout>
<script>
  import '../../../../tools/checksum/checksum.ts';
</script>
<style>
  progress { width: 100%; height: 8px; accent-color: var(--accent-strong); }
  [hidden] { display: none !important; }
  .hrow { display: grid; grid-template-columns: 4.5rem 1fr auto; gap: 10px; align-items: center; }
  .hrow pre { margin: 0; overflow-wrap: anywhere; white-space: pre-wrap; }
  @media (max-width: 520px) { .hrow { grid-template-columns: 1fr auto; } .hrow .meta { grid-column: 1 / -1; } }
</style>
