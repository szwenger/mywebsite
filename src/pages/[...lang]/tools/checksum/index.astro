---
import ToolLayout from '../../../../components/ToolLayout.astro';
import IconButton from '../../../../components/IconButton.astro';
import { LANGS, type Lang } from '../../../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l === 'en' ? undefined : l } }));
}
const lang = (Astro.params.lang ?? 'en') as Lang;
const s = {
  en: {
    drop: 'Drop a file here or click to choose', expected: 'Published SHA-256 (optional)', placeholder: 'Paste the hash or a line from a .sha256 file', result: 'SHA-256 of your file', copy: 'Copy', cancel: 'Cancel',
    reading: 'Reading', match: 'Match: the file is identical to the published one.', mismatch: 'No match: the file differs from the published one. Download it again.', noHash: 'No SHA-256 found in what you pasted (64 hex digits expected).', failed: 'Could not read the file.', cancelled: 'Cancelled.',
  },
  de: {
    drop: 'Datei hierher ziehen oder klicken zum Auswählen', expected: 'Veröffentlichter SHA-256 (optional)', placeholder: 'Hash oder eine Zeile aus einer .sha256-Datei einfügen', result: 'SHA-256 deiner Datei', copy: 'Kopieren', cancel: 'Abbrechen',
    reading: 'Lese', match: 'Treffer: Die Datei ist identisch mit der veröffentlichten.', mismatch: 'Kein Treffer: Die Datei weicht von der veröffentlichten ab. Lade sie erneut herunter.', noHash: 'Kein SHA-256 im eingefügten Text gefunden (erwartet: 64 Hex-Ziffern).', failed: 'Die Datei konnte nicht gelesen werden.', cancelled: 'Abgebrochen.',
  },
  ru: {
    drop: 'Перетащите файл сюда или нажмите для выбора', expected: 'Опубликованный SHA-256 (необязательно)', placeholder: 'Вставьте хеш или строку из файла .sha256', result: 'SHA-256 вашего файла', copy: 'Копировать', cancel: 'Отмена',
    reading: 'Чтение', match: 'Совпадает: файл идентичен опубликованному.', mismatch: 'Не совпадает: файл отличается от опубликованного. Скачайте его заново.', noHash: 'В вставленном тексте нет SHA-256 (нужно 64 шестнадцатеричные цифры).', failed: 'Не удалось прочитать файл.', cancelled: 'Отменено.',
  },
}[lang];
---
<ToolLayout lang={lang} slug="checksum">
  <div class="tl" data-checksum data-s={JSON.stringify(s)}>
    <div class="card pane">
      <label class="drop" data-drop>
        <span>{s.drop}</span>
        <span class="meta" data-file></span>
        <input type="file" data-input />
      </label>
      <label>{s.expected}<input name="expected" class="mono" autocomplete="off" spellcheck="false" placeholder={s.placeholder} /></label>
      <progress max="1" value="0" data-bar hidden></progress>
      <p class="meta" data-status role="status"></p>
      <div class="actions"><button type="button" class="btn alt" data-cancel hidden>{s.cancel}</button></div>
    </div>
    <div class="card pane" data-result hidden>
      <label>{s.result}<pre data-hash></pre></label>
      <div class="actions"><IconButton icon="copy" label={s.copy} data-copy /></div>
      <p class="note" data-verdict hidden role="status"></p>
    </div>
  </div>
</ToolLayout>
<script>
  import '../../../../tools/checksum/checksum.ts';
</script>
<style>
  progress { width: 100%; height: 8px; accent-color: var(--accent-strong); }
</style>
