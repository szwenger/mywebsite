---
import ToolLayout from '../../../../components/ToolLayout.astro';
import IconButton from '../../../../components/IconButton.astro';
import { LANGS, type Lang } from '../../../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l === 'en' ? undefined : l } }));
}
const lang = (Astro.params.lang ?? 'en') as Lang;
const s = {
  en: { drop: 'Drop an image here', or: 'or', browse: 'Choose an image', hint: 'You can also paste a screenshot with Ctrl+V. The picture is shrunk for the analysis; nothing is uploaded.', count: 'Colours', exp: 'Export as', css: 'CSS variables', json: 'JSON list', list: 'Plain list', copy: 'Copy', copied: '✓', other: 'Choose another image', badType: 'That is not an image.', failed: 'This image could not be read.', alt: 'The analysed picture', sw: 'Click a colour to copy its hex code.' },
  de: { drop: 'Bild hier ablegen', or: 'oder', browse: 'Bild wählen', hint: 'Du kannst auch mit Strg+V einen Screenshot einfügen. Für die Analyse wird das Bild verkleinert; nichts wird hochgeladen.', count: 'Farben', exp: 'Exportieren als', css: 'CSS-Variablen', json: 'JSON-Liste', list: 'Einfache Liste', copy: 'Kopieren', copied: '✓', other: 'Anderes Bild wählen', badType: 'Das ist kein Bild.', failed: 'Dieses Bild konnte nicht gelesen werden.', alt: 'Das analysierte Bild', sw: 'Klick auf eine Farbe kopiert ihren Hex-Code.' },
  ru: { drop: 'Перетащите сюда изображение', or: 'или', browse: 'Выбрать изображение', hint: 'Скриншот можно вставить и через Ctrl+V. Для анализа картинка уменьшается; ничего не загружается.', count: 'Цветов', exp: 'Экспорт', css: 'Переменные CSS', json: 'Список JSON', list: 'Простой список', copy: 'Копировать', copied: '✓', other: 'Выбрать другое изображение', badType: 'Это не изображение.', failed: 'Не удалось прочитать это изображение.', alt: 'Анализируемая картинка', sw: 'Щелчок по цвету копирует его hex-код.' },
}[lang];
---
<ToolLayout lang={lang} slug="palette">
  <div class="tl palette" data-palette data-s={JSON.stringify(s)}>
    <div class="drop card" data-drop>
      <p class="big">{s.drop}</p>
      <p class="meta">{s.or}</p>
      <label class="btn pick">{s.browse}<input type="file" accept="image/*" class="sr-only" data-file /></label>
      <p class="meta">{s.hint}</p>
    </div>
    <p class="note bad" role="alert" data-error hidden></p>
    <div class="work" data-work hidden>
      <div class="card pane">
        <img class="pic" data-img alt={s.alt} />
        <label><span>{s.count} <output data-count></output></span><input type="range" aria-label={s.count} name="count" min="2" max="12" value="6" /></label>
        <div class="sws" data-swatches></div>
        <p class="meta">{s.sw}</p>
      </div>
      <div class="card pane">
        <div class="row">
          <label>{s.exp}<select name="kind"><option value="css">{s.css}</option><option value="json">{s.json}</option><option value="list">{s.list}</option></select></label>
          <IconButton icon="copy" label={s.copy} alt={false} data-copy />
          <button type="button" class="btn alt" data-other>{s.other}</button>
        </div>
        <textarea name="export" class="mono" rows="8" readonly spellcheck="false"></textarea>
      </div>
    </div>
  </div>
</ToolLayout>
<script>
  import '../../../../tools/palette/palette.ts';
</script>
<style>
  .drop { display: grid; justify-items: center; gap: 8px; padding: clamp(24px, 4vw, 40px); text-align: center; border-style: dashed; }
  .drop.over { border-color: var(--accent); }
  .big { margin: 0; font-size: 1.15rem; }
  .pick { cursor: pointer; }
  .work { display: grid; gap: 20px; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: start; }
  @media (max-width: 800px) { .work { grid-template-columns: minmax(0, 1fr); } }
  .pic { display: block; max-width: 100%; max-height: 340px; justify-self: center; border-radius: 6px; }
  :global(.palette .sws) { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 8px; }
  :global(.palette .sw) { display: grid; gap: 2px; align-content: end; min-height: 84px; padding: 10px 12px; border: 1px solid #8884; border-radius: 8px; text-align: left; font: inherit; cursor: pointer; }
  :global(.palette .sw b) { font: 600 .95rem ui-monospace, 'Cascadia Mono', Consolas, monospace; }
  :global(.palette .sw span) { font-size: .8rem; opacity: .85; }
  :global(.palette .sw:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
