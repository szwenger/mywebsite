---
import ToolLayout from '../../../../components/ToolLayout.astro';
import { langOf, toolPaths } from '../../../../i18n/tool-page';
import { s as strings } from '../../../../i18n/tools/gen';

export const getStaticPaths = toolPaths;
const lang = langOf(Astro.params);
const s = strings[lang];
---
<ToolLayout lang={lang} slug="gen">
  <div class="tl two" data-gen data-s={JSON.stringify(s)}>
    <div class="card pane">
      <div class="row tabs" role="group">
        <label class="check"><input type="radio" name="kind" value="password" checked /> {s.password}</label>
        <label class="check"><input type="radio" name="kind" value="uuid" /> {s.uuid}</label>
        <label class="check"><input type="radio" name="kind" value="token" /> {s.token}</label>
      </div>
      <div data-when="password" class="stack">
        <label><span>{s.length}: <output name="lenOut">20</output></span><input name="length" aria-label={s.length} type="range" min="6" max="64" value="20" /></label>
        <label class="check"><input type="checkbox" name="lower" checked /> {s.lower}</label>
        <label class="check"><input type="checkbox" name="upper" checked /> {s.upper}</label>
        <label class="check"><input type="checkbox" name="digits" checked /> {s.digits}</label>
        <label class="check"><input type="checkbox" name="symbols" checked /> {s.symbols}</label>
        <label class="check"><input type="checkbox" name="ambiguous" /> {s.ambiguous}</label>
      </div>
      <div data-when="uuid" class="stack" hidden>
        <label>{s.version}<select name="ver"><option value="4">{s.v4}</option><option value="7">{s.v7}</option></select></label>
        <label>{s.count}<input name="count" type="number" min="1" max="100" value="5" /></label>
      </div>
      <div data-when="token" class="stack" hidden>
        <label>{s.bytes}<input name="bytes" type="number" min="8" max="128" value="32" /></label>
        <label>{s.format}<select name="enc"><option value="hex">hex</option><option value="base64url">base64url</option><option value="base64">base64</option></select></label>
      </div>
    </div>
    <div class="card pane" aria-live="polite">
      <pre class="big" data-out></pre>
      <p class="note" data-strength hidden></p>
      <div class="actions">
        <button type="button" class="btn" data-regen>{s.regen}</button>
        <button type="button" class="btn alt" data-copy>{s.copyAll}</button>
      </div>
      <p class="meta">{s.note}</p>
    </div>
  </div>
</ToolLayout>
<script>
  import '../../../../tools/gen/gen.ts';
</script>
<style>
  .stack { display: grid; gap: 14px; }
  .stack[hidden] { display: none; }
  .big { font-size: 1.05rem; word-break: break-all; user-select: all; }
</style>
