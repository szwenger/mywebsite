---
import ToolLayout from '../../../../components/ToolLayout.astro';
import IconButton from '../../../../components/IconButton.astro';
import { LANGS, type Lang } from '../../../../i18n/ui';
import { s as barcodeStrings } from '../../../../i18n/tools/barcode';

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l === 'en' ? undefined : l } }));
}
const lang = (Astro.params.lang ?? 'en') as Lang;
const s = {
  en: {
    kinds: 'Type', kQr: 'QR code', kBar: 'Barcode',
    modes: 'Content', link: 'Link / text', wifi: 'Wi-Fi', contact: 'Contact',
    text: 'Text or link', ssid: 'Network name (SSID)', password: 'Password', security: 'Security', none: 'No password', hidden: 'Hidden network',
    name: 'Name', phone: 'Phone', email: 'Email', url: 'Website', org: 'Organisation',
    fg: 'Code colour', bg: 'Background', size: 'Size', px: 'px',
    low: 'Low contrast: this code may not scan. Pick a darker code colour or a lighter background.',
    png: 'Download PNG', svg: 'Download SVG', preview: 'Preview',
    empty: 'Fill in the form to see your code.', tooLong: 'Too much data for a QR code. Shorten the text.',
    design: 'Style', shape: 'Modules', sSquare: 'Square', sRounded: 'Rounded', sDots: 'Dots',
    finder: 'Corner eyes', fSquare: 'Square', fRounded: 'Rounded', fCircle: 'Round',
    gradient: 'Colour fade', gNone: 'None', gLinear: 'Diagonal', gRadial: 'Radial', fg2: 'Fade to',
    logo: 'Centre image', logoSize: 'Image size', logoClear: 'Remove image', logoNote: 'Error correction is raised to the highest level so the code still scans.',
    frame: 'Frame', frNone: 'None', frBox: 'Box', frRounded: 'Rounded box', frLabel: 'Label', label: 'Label text',
  },
  de: {
    kinds: 'Art', kQr: 'QR-Code', kBar: 'Barcode',
    modes: 'Inhalt', link: 'Link / Text', wifi: 'WLAN', contact: 'Kontakt',
    text: 'Text oder Link', ssid: 'Netzwerkname (SSID)', password: 'Passwort', security: 'Sicherheit', none: 'Kein Passwort', hidden: 'Verstecktes Netzwerk',
    name: 'Name', phone: 'Telefon', email: 'E-Mail', url: 'Webseite', org: 'Organisation',
    fg: 'Codefarbe', bg: 'Hintergrund', size: 'Größe', px: 'px',
    low: 'Geringer Kontrast: Der Code lässt sich vielleicht nicht scannen. Wähle eine dunklere Codefarbe oder einen helleren Hintergrund.',
    png: 'PNG herunterladen', svg: 'SVG herunterladen', preview: 'Vorschau',
    empty: 'Fülle das Formular aus, um deinen Code zu sehen.', tooLong: 'Zu viele Daten für einen QR-Code. Kürze den Text.',
    design: 'Stil', shape: 'Module', sSquare: 'Quadrat', sRounded: 'Abgerundet', sDots: 'Punkte',
    finder: 'Eckaugen', fSquare: 'Quadrat', fRounded: 'Abgerundet', fCircle: 'Rund',
    gradient: 'Farbverlauf', gNone: 'Keiner', gLinear: 'Diagonal', gRadial: 'Radial', fg2: 'Verlauf nach',
    logo: 'Bild in der Mitte', logoSize: 'Bildgröße', logoClear: 'Bild entfernen', logoNote: 'Die Fehlerkorrektur wird auf die höchste Stufe gesetzt, damit der Code lesbar bleibt.',
    frame: 'Rahmen', frNone: 'Keiner', frBox: 'Kasten', frRounded: 'Runder Kasten', frLabel: 'Beschriftung', label: 'Beschriftungstext',
  },
  ru: {
    kinds: 'Тип', kQr: 'QR-код', kBar: 'Штрихкод',
    modes: 'Содержимое', link: 'Ссылка / текст', wifi: 'Wi-Fi', contact: 'Контакт',
    text: 'Текст или ссылка', ssid: 'Имя сети (SSID)', password: 'Пароль', security: 'Защита', none: 'Без пароля', hidden: 'Скрытая сеть',
    name: 'Имя', phone: 'Телефон', email: 'Эл. почта', url: 'Сайт', org: 'Организация',
    fg: 'Цвет кода', bg: 'Фон', size: 'Размер', px: 'px',
    low: 'Низкий контраст: код может не считываться. Выберите более тёмный цвет кода или более светлый фон.',
    png: 'Скачать PNG', svg: 'Скачать SVG', preview: 'Предпросмотр',
    empty: 'Заполните форму, чтобы увидеть код.', tooLong: 'Слишком много данных для QR-кода. Сократите текст.',
    design: 'Стиль', shape: 'Модули', sSquare: 'Квадраты', sRounded: 'Скруглённые', sDots: 'Точки',
    finder: 'Угловые маркеры', fSquare: 'Квадрат', fRounded: 'Скруглённый', fCircle: 'Круглый',
    gradient: 'Градиент', gNone: 'Нет', gLinear: 'Диагональный', gRadial: 'Радиальный', fg2: 'Цвет конца',
    logo: 'Картинка в центре', logoSize: 'Размер картинки', logoClear: 'Убрать картинку', logoNote: 'Коррекция ошибок ставится на максимум, чтобы код читался.',
    frame: 'Рамка', frNone: 'Нет', frBox: 'Рамка', frRounded: 'Скруглённая рамка', frLabel: 'Подпись', label: 'Текст подписи',
  },
}[lang];
const bs = barcodeStrings[lang];
---
<ToolLayout lang={lang} slug="qr">
  <div class="kinds" role="group" aria-label={s.kinds}>
    <label class="check"><input type="radio" name="kind" value="qr" checked /> {s.kQr}</label>
    <label class="check"><input type="radio" name="kind" value="barcode" /> {s.kBar}</label>
  </div>
  <div class="qr" data-qr data-too-long={s.tooLong} data-kind="qr">
    <div class="controls card">
      <div class="tabs" role="tablist" aria-label={s.modes}>
        <button type="button" role="tab" id="tab-link" aria-controls="panel-link" aria-selected="true" data-mode="link">{s.link}</button>
        <button type="button" role="tab" id="tab-wifi" aria-controls="panel-wifi" aria-selected="false" tabindex="-1" data-mode="wifi">{s.wifi}</button>
        <button type="button" role="tab" id="tab-contact" aria-controls="panel-contact" aria-selected="false" tabindex="-1" data-mode="contact">{s.contact}</button>
      </div>

      <div class="panel" role="tabpanel" id="panel-link" aria-labelledby="tab-link" data-panel="link">
        <label>{s.text}<textarea name="text" rows="4"></textarea></label>
      </div>
      <div class="panel" role="tabpanel" id="panel-wifi" aria-labelledby="tab-wifi" data-panel="wifi" hidden>
        <label>{s.ssid}<input name="ssid" autocomplete="off" /></label>
        <label>{s.password}<input name="password" autocomplete="off" /></label>
        <label>{s.security}
          <select name="security"><option value="WPA">WPA/WPA2/WPA3</option><option value="WEP">WEP</option><option value="nopass">{s.none}</option></select>
        </label>
        <label class="check"><input type="checkbox" name="hidden" /> {s.hidden}</label>
      </div>
      <div class="panel" role="tabpanel" id="panel-contact" aria-labelledby="tab-contact" data-panel="contact" hidden>
        <label>{s.name}<input name="name" autocomplete="off" /></label>
        <label>{s.phone}<input name="phone" type="tel" autocomplete="off" /></label>
        <label>{s.email}<input name="email" type="email" autocomplete="off" /></label>
        <label>{s.url}<input name="url" type="url" autocomplete="off" /></label>
        <label>{s.org}<input name="org" autocomplete="off" /></label>
      </div>

      <div class="style">
        <label>{s.fg}<input type="color" name="fg" value="#000000" /></label>
        <label>{s.bg}<input type="color" name="bg" value="#ffffff" /></label>
        <label class="size"><span>{s.size}: <output name="sizeOut">512</output> {s.px}</span><input type="range" name="size" aria-label={s.size} min="128" max="1024" step="16" value="512" /></label>
      </div>
      <div class="design" data-design>
        <h3>{s.design}</h3>
        <div class="grid3">
          <label>{s.shape}<select name="shape"><option value="square">{s.sSquare}</option><option value="rounded">{s.sRounded}</option><option value="dots">{s.sDots}</option></select></label>
          <label>{s.finder}<select name="finder"><option value="square">{s.fSquare}</option><option value="rounded">{s.fRounded}</option><option value="circle">{s.fCircle}</option></select></label>
          <label>{s.gradient}<select name="gradient"><option value="none">{s.gNone}</option><option value="linear">{s.gLinear}</option><option value="radial">{s.gRadial}</option></select></label>
          <label data-when="gradient" hidden>{s.fg2}<input type="color" name="fg2" value="#5563c6" /></label>
          <label>{s.frame}<select name="frame"><option value="none">{s.frNone}</option><option value="box">{s.frBox}</option><option value="rounded">{s.frRounded}</option><option value="label">{s.frLabel}</option></select></label>
          <label data-when="label" hidden>{s.label}<input name="label" value="Scan me" maxlength="24" autocomplete="off" /></label>
        </div>
        <div class="logo">
          <label>{s.logo}<input type="file" name="logo" accept="image/*" /></label>
          <label data-when="logo" hidden><span>{s.logoSize}</span><input type="range" name="logosize" aria-label={s.logoSize} min="10" max="30" step="1" value="20" /></label>
          <button type="button" class="btn alt" data-logo-clear data-when="logo" hidden>{s.logoClear}</button>
        </div>
        <p class="meta" data-when="logo" hidden>{s.logoNote}</p>
      </div>
      <p class="warn" role="status" data-warn data-text={s.low} hidden></p>
    </div>

    <div class="out card">
      <h2 class="sr-only">{s.preview}</h2>
      <div class="stage">
        <canvas data-canvas width="512" height="512" role="img" aria-label={s.preview} hidden></canvas>
        <p class="meta" data-empty>{s.empty}</p>
        <p class="warn" role="status" data-error hidden></p>
      </div>
      <div class="actions">
        <button type="button" class="btn" data-download="png" disabled>{s.png}</button>
        <button type="button" class="btn alt" data-download="svg" disabled>{s.svg}</button>
      </div>
    </div>
  </div>

    <div class="tl two" data-barcode data-kind="barcode" hidden data-s={JSON.stringify(bs)}>
      <div class="card pane">
        <label>{bs.type}<select name="kind"><option value="code128">Code 128</option><option value="ean13">EAN-13</option><option value="ean8">EAN-8</option><option value="upca">UPC-A</option></select></label>
        <label>{bs.text}<input name="text" class="mono" value="GALUIN-2026" autocomplete="off" spellcheck="false" /></label>
        <p class="meta" data-hint></p>
        <div class="row">
          <label>{bs.size}<input name="module" type="range" min="1" max="6" value="2" /></label>
          <label>{bs.height}<input name="height" type="range" min="40" max="200" value="90" /></label>
        </div>
        <p class="meta">{bs.note}</p>
      </div>
      <div class="card pane" aria-live="polite">
        <p class="note bad" data-error role="alert" hidden></p>
        <div class="preview" data-preview></div>
        <div class="actions">
          <button type="button" class="btn" data-png>{bs.png}</button>
          <button type="button" class="btn alt" data-svg>{bs.svg}</button>
          <IconButton icon="copy" label={bs.copy} data-copy />
        </div>
      </div>
    </div>
</ToolLayout>
<script>
  import '../../../../tools/qr/qr.ts';
  import '../../../../tools/qr/barcode.ts';
</script>
<style>
  .qr { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .controls, .out { padding: clamp(16px, 2.4vw, 26px); }
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .tabs button { padding: 7px 16px; border: 1px solid var(--line); border-radius: 99px; background: transparent; color: var(--muted); font: inherit; font-size: .9rem; cursor: pointer; }
  .tabs button[aria-selected='true'] { background: var(--accent-strong); border-color: var(--accent-strong); color: #fff; }
  .panel { display: grid; gap: 14px; }
  .panel[hidden] { display: none; }
  label { display: grid; gap: 6px; font-size: .88rem; color: var(--muted); }
  input:not([type='checkbox'], [type='radio'], [type='color'], [type='range']), textarea, select {
    width: 100%; padding: 9px 12px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface-2); color: var(--fg); font: inherit; font-size: .95rem;
  }
  textarea { resize: vertical; }
  .check { display: flex; align-items: center; gap: 8px; }
  .style { display: flex; flex-wrap: wrap; gap: 16px 24px; margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); align-items: end; }
  .style .size { flex: 1 1 220px; }
  input[type='color'] { width: 56px; height: 34px; padding: 2px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface-2); cursor: pointer; }
  input[type='range'] { width: 100%; accent-color: var(--accent-strong); }
  .warn { margin: 14px 0 0; padding: 9px 12px; border-radius: var(--radius-sm); border: 1px solid var(--line); background: var(--surface-2); font-size: .88rem; }
  .stage { display: grid; place-items: center; min-height: 260px; padding: 12px; border-radius: var(--radius-sm); border: 1px dashed var(--line); }
  canvas { max-width: 100%; height: auto; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .btn[disabled] { opacity: .45; cursor: not-allowed; }
  .btn.alt { background: transparent; color: var(--fg); border: 1px solid var(--line); }
  .kinds { display: flex; gap: 18px; margin-bottom: 16px; }
  .kinds .check { display: flex; align-items: center; gap: 8px; }
  .preview { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 12px; overflow: auto; display: grid; justify-items: center; }
  :global(.preview svg) { max-width: 100%; height: auto; }
  [data-kind][hidden] { display: none; }
  .design { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); display: grid; gap: 14px; }
  .design h3 { margin: 0; font-size: .95rem; font-weight: 600; }
  .grid3 { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; align-items: end; }
  .logo { display: flex; flex-wrap: wrap; gap: 14px; align-items: end; }
  .logo label:first-child { flex: 1 1 220px; }
  .logo input[type='file'] { font: inherit; font-size: .9rem; color: var(--muted); }
  [data-when][hidden] { display: none; }
  @media (max-width: 860px) { .qr { grid-template-columns: minmax(0, 1fr); } }
</style>
