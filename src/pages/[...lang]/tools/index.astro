---
import Base from '../../../layouts/Base.astro';
import ExpandSearch from '../../../components/ExpandSearch.astro';
import Version from '../../../components/Version.astro';
import { latest } from '../../../data/changelog';
import { s as cl } from '../../../i18n/tools/changelog';
import { LANGS, path, t, type Lang } from '../../../i18n/ui';
import { tools, categories, categoryIcons, topics, topicIcons, type Category, type Topic } from '../../../data/tools';

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l === 'en' ? undefined : l } }));
}
const lang = (Astro.params.lang ?? 'en') as Lang;
const cats = Object.keys(categories) as Category[];
const topicIds = Object.keys(topics) as Topic[];
const now = latest();
---
<Base lang={lang} title={`${t(lang, 'navTools')} · Galuin`} description={t(lang, 'toolsIntro')} current="tools">
  <section class="wrap page">
    <div class="head">
      <h1 class="section-title">{t(lang, 'navTools')}</h1>
      <ExpandSearch label={t(lang, 'toolsSearch')} clear={t(lang, 'searchClear')} />
    </div>
    <div class="intro-row">
      <p class="meta intro">{t(lang, 'toolsLocal')}</p>
      <a class="verlink" href={path(lang, '/changelog/')} data-version={now.version} data-date={now.date}>{cl[lang].version} <span class="num"><Version v={now.version} /></span> · {cl[lang].notes}<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
    </div>
    <nav class="chips" aria-label={t(lang, 'toolsCategories')}>
      <a class="chip" href="#" data-chip="" aria-current="true">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
        <span>{t(lang, 'allTools')}</span><small data-n>{tools.length}</small>
      </a>
      {cats.map((cat) => (
        <a class="chip" href={`#${cat}`} data-chip={cat}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={categoryIcons[cat]} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span>{categories[cat][lang]}</span><small data-n>{tools.filter((x) => x.cat === cat).length}</small>
        </a>
      ))}
      {topicIds.map((id) => (
        <a class="chip" href={`#${id}`} data-chip={id}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={topicIcons[id]} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span>{topics[id][lang]}</span><small data-n>{tools.filter((x) => x.topics?.includes(id)).length}</small>
        </a>
      ))}
    </nav>
    {cats.map((cat) => (
      <section class="group" data-group data-cat={cat} aria-labelledby={`cat-${cat}`}>
        <h2 class="cat" id={`cat-${cat}`}>{categories[cat][lang]}</h2>
        <div class="grid">
          {tools.filter((x) => x.cat === cat).map((tool) => (
            <a class="card tool" href={path(lang, `/tools/${tool.slug}/`)} data-hay={[tool.name[lang], tool.blurb[lang], tool.tags ?? '', tool.slug, categories[cat][lang], ...(tool.topics ?? []).map((k) => topics[k][lang])].join(' ')} data-topics={(tool.topics ?? []).join(' ')} data-in={(tool.accepts ?? []).join(' ')} data-out={(tool.produces ?? []).join(' ')}>
              <span class="icon"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d={tool.icon} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              <div class="text">
                <h3>{tool.name[lang]}</h3>
                <p>{tool.blurb[lang]}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
    <p class="meta empty" data-ts-empty role="status" hidden>{t(lang, 'noResults')}</p>
  </section>
</Base>
<script>
  import '../../../scripts/toolsearch.ts';
  import { isNew } from '../../../data/changelog';
  // The version number stands out until the changelog has been opened (or, on a first visit, while the version is under two weeks old).
  const link = document.querySelector<HTMLElement>('.verlink');
  let seen: string | null = null;
  try { seen = localStorage.getItem('changelogSeen'); } catch { /* storage blocked */ }
  if (link && isNew(link.dataset.version!, seen, link.dataset.date!, new Date().toISOString().slice(0, 10))) link.classList.add('unseen');
</script>
<style>
  .page { padding-block: clamp(32px, 6vw, 64px) 0; }
  .head { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; margin-bottom: 16px; }
  .head .section-title { margin: 0; }
  .intro-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin: -6px 0 24px; }
  .intro { margin: 0; font-size: .95rem; }
  .verlink { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; color: var(--muted); font-size: .92rem; text-decoration: none; }
  .verlink:hover { color: var(--fg); }
  .verlink .num { font-weight: 600; color: var(--fg); }
  .verlink.unseen .num { color: var(--accent-ink); }
  .verlink svg { margin-left: 2px; transition: translate .2s var(--ease); }
  .verlink:hover svg { translate: 3px 0; }
  @media (prefers-reduced-motion: reduce) { .verlink svg { transition: none; } }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
  .chip { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 14px 0 12px; border: 1px solid var(--line); border-radius: 99px; color: var(--muted); font-size: .92rem; font-weight: 500; text-decoration: none; white-space: nowrap; transition: color .15s, background-color .15s, border-color .15s, opacity .15s; }
  .chip svg { flex: none; }
  .chip small { min-width: 1.4em; padding: 1px 6px; border-radius: 99px; background: var(--surface-2); color: var(--muted); font-size: .75rem; line-height: 1.4; text-align: center; font-variant-numeric: tabular-nums; }
  .chip:hover { color: var(--fg); background: var(--surface); }
  .chip[aria-current='true'] { color: var(--fg); background: var(--surface-2); border-color: var(--accent); }
  .chip[aria-current='true'] svg { color: var(--accent-ink); }
  .chip[data-zero] { opacity: .45; }
  @media (max-width: 760px) {
    .chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(-1 * var(--gutter)); padding: 2px var(--gutter); }
  }
  @media (prefers-reduced-motion: reduce) { .chip { transition: none; } }
  .group { margin-top: 36px; }
  .cat { margin: 0 0 14px; font-size: .95rem; font-family: var(--font); font-weight: 600; letter-spacing: 0; color: var(--muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 440px), 1fr)); gap: 20px; }
  .tool { display: flex; align-items: flex-start; gap: 20px; padding: 24px; }
  .icon { display: grid; place-items: center; flex: none; width: 48px; height: 48px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface-2); color: var(--accent-ink); }
  .text { min-width: 0; }
  .tool h3 { margin: 0 0 8px; font-size: 1.1rem; }
  .tool p { margin: 0; color: var(--muted); font-size: .92rem; }
  .tool[hidden], .group[hidden] { display: none; }
  .empty { margin-top: 40px; text-align: center; }
</style>
