---
import ToolLayout from '../../../../components/ToolLayout.astro';
import Icon from '../../../../components/Icon.astro';
import { LANGS, type Lang } from '../../../../i18n/ui';
import { pdfStrings, TABS } from '../../../../tools/pdf/strings';
import '../../../../styles/tools.css';

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l === 'en' ? undefined : l } }));
}
const lang = (Astro.params.lang ?? 'en') as Lang;
const s = pdfStrings[lang];
// Tabs that share the page editor open the "edit" panel.
const panelOf = (id: string) => (id === 'sign' || id === 'redact' ? 'edit' : id);
const SEL = ['all', 'none', 'odd', 'even', 'invert', 'rotr', 'rotl', 'del', 'keep', 'dup', 'first', 'last', 'save'];
const NEEDS = ['del', 'keep', 'dup', 'first', 'last', 'save'];
const POS = ['tl', 'tc', 'tr', 'bl', 'bc', 'br'];
const SHEETS = ['A4', 'A3', 'A5', 'A6', 'Letter', 'Legal', 'Tabloid'];
const TPL = ['{n}', { en: 'Page {n} of {total}', de: 'Seite {n} von {total}', ru: 'Страница {n} из {total}' }[Astro.params.lang ?? 'en'] ?? 'Page {n} of {total}', '{n} / {total}', '– {n} –'];
const TOOLS = ['text', 'image', 'draw', 'highlight', 'whiteout', 'select'];
---
<ToolLayout lang={lang} slug="pdf">
  <div class="pdf" data-pdf data-strings={JSON.stringify(s)}>
    <div class="dropzone card" data-drop>
      <p class="big">{s.drop}</p>
      <div class="picks">
        <label class="btn pick">{s.browse}<input type="file" accept="application/pdf,image/*,.pdf" multiple data-file class="sr-only" /></label>
        <label class="btn alt pick camera">{s.camera}<input type="file" accept="image/*" capture="environment" data-camera class="sr-only" /></label>
      </div>
      <p class="meta hint">{s.hint}</p>
    </div>

    <p class="warn" role="alert" data-error hidden></p>
    <p class="meta" role="status" data-status></p>

    <form class="unlock card" data-unlock hidden>
      <label>{s.unlockLabel}<input type="password" name="pw" autocomplete="off" required /></label>
      <button type="submit" class="btn">{s.unlockBtn}</button>
    </form>

    <nav class="tabs" aria-label={s.tabsLabel}>
      {TABS.map((id) => (
        <button type="button" class="tab" data-tab={id} data-to={panelOf(id)} aria-selected="false">
          <strong>{s[`t_${id}`]}</strong>
          <span>{s[`d_${id}`]}</span>
        </button>
      ))}
    </nav>

    <div class="work" data-work hidden>
      <div class="bar card">
        <p class="meta stats" data-stats></p>
        <div class="row end">
          <button type="button" class="btn alt" data-undo disabled>{s.undo}</button>
          <button type="button" class="btn alt" data-reset>{s.reset}</button>
          <button type="button" class="btn" data-download><Icon name="download" size={16} />{s.download}</button>
        </div>
      </div>

      <section class="card panel tl" data-panel="organize" hidden>
        <p class="meta">{s.selHelp}</p>
        <div class="selbar" role="toolbar" aria-label={s.pagesLabel}>
          {SEL.map((k) => <button type="button" class="btn alt sm" data-sel={k} data-needsel={NEEDS.includes(k) ? '' : undefined} disabled={NEEDS.includes(k)}>{s[`sel_${k}`]}</button>)}
        </div>
        <label class="range">{s.rangeLabel}
          <span class="row"><input data-range placeholder={s.rangePlaceholder} autocomplete="off" /><button type="button" class="btn alt" data-range-keep>{s.rangeBtn}</button></span>
        </label>
        <h2 class="sr-only">{s.pagesLabel}</h2>
        <ol class="pages" data-pages></ol>
      </section>

      <section class="card panel tl" data-panel="split" hidden>
        <fieldset class="opts"><legend>{s.splitMode}</legend>
          <label class="check"><input type="radio" name="mode" value="each" checked />{s.mode_each}</label>
          <label class="check"><input type="radio" name="mode" value="every" />{s.mode_every}</label>
          <label class="check"><input type="radio" name="mode" value="ranges" />{s.mode_ranges}</label>
        </fieldset>
        <div class="row">
          <label>{s.everyLabel}<input type="number" name="every" min="1" value="2" /></label>
          <label>{s.rangesLabel}<input name="ranges" placeholder={s.rangesPlaceholder} autocomplete="off" /></label>
        </div>
        <div class="actions"><button type="button" class="btn" data-do="split">{s.splitBtn}</button></div>
        <p class="note" data-out hidden></p>
      </section>

      <section class="card panel tl" data-panel="arrange" hidden>
        <div class="actions">
          <button type="button" class="btn alt" data-do="reverse">{s.reverse}</button>
          <button type="button" class="btn alt" data-do="odd">{s.oddOnly}</button>
          <button type="button" class="btn alt" data-do="even">{s.evenOnly}</button>
        </div>
        <h3>{s.blankInsertTitle}</h3>
        <div class="row">
          <label>{s.blankAfter}<input name="after" autocomplete="off" /></label>
          <button type="button" class="btn alt" data-do="blank-insert">{s.blankInsertBtn}</button>
        </div>
        <h3>{s.blankRemoveTitle}</h3>
        <fieldset class="opts">
          <label class="check"><input type="radio" name="sens" value="0.0003" />{s.sens_low}</label>
          <label class="check"><input type="radio" name="sens" value="0.002" checked />{s.sens_mid}</label>
          <label class="check"><input type="radio" name="sens" value="0.01" />{s.sens_high}</label>
        </fieldset>
        <div class="actions"><button type="button" class="btn alt" data-do="blank-remove">{s.blankRemoveBtn}</button></div>
        <p class="note" data-out hidden></p>
      </section>

      <section class="card panel tl" data-panel="compress" hidden>
        <fieldset class="opts levels">
          {(['light', 'balanced', 'strong', 'max'] as const).map((k) => (
            <label class="check lvl"><input type="radio" name="level" value={k} checked={k === 'balanced'} /><span><strong>{s[`lvl_${k}`]}</strong><br />{s[`lvl_${k}_d`]}</span></label>
          ))}
        </fieldset>
        <div class="actions"><button type="button" class="btn" data-do="compress">{s.compressBtn}</button></div>
        <p class="note" data-out hidden></p>
      </section>

      <section class="card panel tl" data-panel="convert" hidden>
        <h3>{s.toImages}</h3>
        <div class="row">
          <label>{s.fmt}<select name="fmt"><option value="png">PNG</option><option value="jpeg">JPEG</option><option value="webp">WebP</option></select></label>
          <label>{s.dpiLabel}<input type="number" name="dpi" min="36" max="400" value="150" /></label>
          <button type="button" class="btn" data-do="images">{s.imagesBtn}</button>
        </div>
        <div class="actions">
          <button type="button" class="btn alt" data-do="text">{s.toText}</button>
          <button type="button" class="btn alt" data-do="docx">{s.toDocx}</button>
          <button type="button" class="btn alt" data-do="extimg">{s.extImg}</button>
        </div>
        <p class="meta">{s.convertNote}</p>
        <div class="actions">
          <button type="button" class="btn alt" data-do="gray">{s.toGray}</button>
          <button type="button" class="btn alt" data-do="invert">{s.toInvert}</button>
          <button type="button" class="btn alt" data-do="flat">{s.toFlat}</button>
        </div>
        <p class="note" data-out hidden></p>
      </section>

      <section class="card panel tl" data-panel="number" hidden>
        <fieldset class="opts grid3"><legend>{s.posLabel}</legend>
          {POS.map((p) => <label class="check"><input type="radio" name="pos" value={p} checked={p === 'bc'} />{s[`pos_${p}`]}</label>)}
        </fieldset>
        <label>{s.tplLabel}<input name="template" value="{n}" autocomplete="off" /></label>
        <div class="actions">{TPL.map((t) => <button type="button" class="btn alt sm" data-tpl={t}>{t}</button>)}</div>
        <div class="row">
          <label>{s.startLabel}<input type="number" name="start" value="1" /></label>
          <label>{s.firstLabel}<input type="number" name="first" min="1" value="1" /></label>
          <label>{s.sizeLabel}<input type="number" name="size" min="4" max="72" value="11" /></label>
          <label>{s.marginLabel}<input type="number" name="margin" min="0" max="200" value="28" /></label>
          <label>{s.colorLabel}<input type="color" name="color" value="#000000" /></label>
        </div>
        <div class="prev" data-prev="number" hidden></div>
        <div class="actions"><button type="button" class="btn" data-do="number">{s.numberBtn}</button></div>
      </section>

      <section class="card panel tl" data-panel="watermark" hidden>
        <fieldset class="opts">
          <label class="check"><input type="radio" name="wmkind" value="text" checked />{s.wmText}</label>
          <label class="check"><input type="radio" name="wmkind" value="image" />{s.wmImage}</label>
        </fieldset>
        <label>{s.wmTextLabel}<input name="text" value="CONFIDENTIAL" autocomplete="off" /></label>
        <div class="row">
          <label>{s.sizeLabel}<input type="number" name="size" min="8" max="300" value="64" /></label>
          <label>{s.angleLabel}<input type="number" name="angle" min="-90" max="90" value="45" /></label>
          <label>{s.opacityLabel}<input type="number" name="opacity" min="1" max="100" value="20" /></label>
          <label>{s.colorLabel}<input type="color" name="color" value="#808080" /></label>
        </div>
        <div class="row">
          <label>{s.wmFile}<input type="file" name="wmimg" accept="image/*" /></label>
          <label>{s.wmWidth}<input type="number" name="imgsize" min="5" max="100" value="50" /></label>
          <label>{s.opacityLabel}<input type="number" name="imgopacity" min="1" max="100" value="30" /></label>
        </div>
        <label>{s.pagesField}<input name="pages" placeholder={s.rangePlaceholder} autocomplete="off" /></label>
        <div class="prev" data-prev="watermark" hidden></div>
        <div class="actions"><button type="button" class="btn" data-do="watermark">{s.wmBtn}</button></div>
      </section>

      <section class="card panel tl" data-panel="edit" hidden>
        <div class="etools" role="toolbar" aria-label={s.t_edit}>
          {TOOLS.map((k) => <button type="button" class="btn alt sm" data-etool={k} aria-pressed="false">{s[`tool_${k}`]}</button>)}
          <button type="button" class="btn alt sm" data-etool="sign" aria-pressed="false">{s.tool_sign}</button>
          <button type="button" class="btn alt sm" data-etool="redact" aria-pressed="false">{s.tool_redact}</button>
        </div>
        <p class="meta" data-hint></p>
        <div class="row efields">
          <label data-for="text select">{s.eText}<input name="etext" autocomplete="off" /></label>
          <label data-for="text select">{s.eSize}<input type="number" name="esize" min="4" max="200" value="18" /></label>
          <label data-for="text draw select">{s.eColor}<input type="color" name="ecolor" value="#d62828" /></label>
          <label data-for="draw select">{s.eWidth}<input type="number" name="ewidth" min="1" max="30" value="2" /></label>
        </div>
        <div data-imgbox hidden><label>{s.eImage}<input type="file" name="eimg" accept="image/*" /></label></div>
        <div class="sig" data-sigbox hidden>
          <p class="meta">{s.sigDraw}</p>
          <canvas data-pad width="600" height="220" aria-label={s.sigDraw}></canvas>
          <div class="actions">
            <button type="button" class="btn alt sm" data-sigclear>{s.sigClear}</button>
            <button type="button" class="btn sm" data-siguse>{s.sigUse}</button>
          </div>
          <div class="row">
            <label>{s.sigTyped}<input name="sigtext" autocomplete="off" /></label>
            <button type="button" class="btn alt sm" data-sigtype>{s.sigType}</button>
          </div>
          <label>{s.sigUpload}<input type="file" name="sigimg" accept="image/*" /></label>
          <p class="note good" data-sigok hidden>{s.sigReady}</p>
        </div>
        <div class="enav">
          <button type="button" class="btn alt sm ib" data-eprev aria-label={s.ePrev}><Icon name="prev" size={15} /></button>
          <label class="inl">{s.ePage}<input type="number" name="epage" min="1" value="1" /></label>
          <button type="button" class="btn alt sm ib" data-enext aria-label={s.eNext}><Icon name="next" size={15} /></button>
          <button type="button" class="btn alt sm" data-edel disabled>{s.eDel}</button>
          <button type="button" class="btn alt sm" data-eclear>{s.eClear}</button>
          <span class="meta" data-ecount></span>
        </div>
        <div class="stage" data-stage><div class="eover" data-over></div></div>
        <div class="actions"><button type="button" class="btn" data-do="apply" disabled>{s.apply}</button></div>
      </section>

      <section class="card panel tl" data-panel="crop" hidden>
        <h3>{s.cropTitle}</h3>
        <div class="row">
          <label>{s.top}<input type="number" name="top" min="0" value="0" /></label>
          <label>{s.right}<input type="number" name="right" min="0" value="0" /></label>
          <label>{s.bottom}<input type="number" name="bottom" min="0" value="0" /></label>
          <label>{s.left}<input type="number" name="left" min="0" value="0" /></label>
        </div>
        <label>{s.pagesField}<input name="pages" placeholder={s.rangePlaceholder} autocomplete="off" /></label>
        <div class="prev" data-prev="crop" hidden></div>
        <div class="actions"><button type="button" class="btn" data-do="crop">{s.cropBtn}</button></div>
        <h3>{s.autoTitle}</h3>
        <div class="row">
          <label>{s.padLabel}<input type="number" name="pad" min="0" max="100" value="8" /></label>
          <button type="button" class="btn alt" data-do="autocrop">{s.autoBtn}</button>
        </div>
        <div class="prev" data-prev="autocrop" hidden></div>
        <h3>{s.resizeTitle}</h3>
        <div class="row">
          <label>{s.sheetLabel}<select name="psize">{SHEETS.map((k) => <option value={k} selected={k === 'A4'}>{k}</option>)}</select></label>
          <label>{s.orientLabel}<select name="orient"><option value="portrait">{s.orient_p}</option><option value="landscape">{s.orient_l}</option></select></label>
          <label>{s.marginLabel}<input type="number" name="pmargin" min="0" value="0" /></label>
          <button type="button" class="btn alt" data-do="resize">{s.resizeBtn}</button>
        </div>
        <div class="prev" data-prev="resize" hidden></div>
      </section>

      <section class="card panel tl" data-panel="nup" hidden>
        <h3>{s.nupTitle}</h3>
        <div class="row">
          <label>{s.perLabel}<select name="per">{['2', '4', '6', '8', '9'].map((k) => <option value={k} selected={k === '2'}>{k}</option>)}</select></label>
          <label>{s.sheetLabel}<select name="sheet"><option value="first">{s.sheetFirst}</option>{SHEETS.map((k) => <option value={k}>{k}</option>)}</select></label>
          <label>{s.orientLabel}<select name="orient"><option value="portrait">{s.orient_p}</option><option value="landscape">{s.orient_l}</option></select></label>
        </div>
        <div class="row">
          <label>{s.marginLabel.replace('pt', 'mm')}<input type="number" name="margin" min="0" value="8" /></label>
          <label>{s.gapLabel}<input type="number" name="gap" min="0" value="4" /></label>
          <label class="check"><input type="checkbox" name="border" />{s.borderLabel}</label>
        </div>
        <div class="prev" data-prev="nup" hidden></div>
        <div class="actions"><button type="button" class="btn" data-do="nup">{s.nupBtn}</button></div>
        <h3>{s.bookletTitle}</h3>
        <p class="meta">{s.bookletNote}</p>
        <div class="row">
          <label>{s.sheetLabel}<select name="sheet"><option value="first">{s.sheetFirst}</option>{SHEETS.map((k) => <option value={k}>{k}</option>)}</select></label>
          <button type="button" class="btn alt" data-do="booklet">{s.bookletBtn}</button>
        </div>
        <div class="prev" data-prev="booklet" hidden></div>
      </section>

      <section class="card panel tl" data-panel="forms" hidden>
        <p class="note" data-nofields hidden>{s.noFields}</p>
        <div data-hasfields hidden class="tl">
          <div class="fields" data-fields></div>
          <label class="check"><input type="checkbox" name="flatten" />{s.flattenLabel}</label>
          <div class="actions">
            <button type="button" class="btn" data-do="fill">{s.fillBtn}</button>
            <button type="button" class="btn alt" data-do="flatten">{s.flattenBtn}</button>
          </div>
        </div>
        <p class="note" data-out hidden></p>
      </section>

      <section class="card panel tl" data-panel="protect" hidden>
        <div class="row">
          <label>{s.upw}<input type="password" name="upw" autocomplete="new-password" /></label>
          <label>{s.opw}<input type="password" name="opw" autocomplete="new-password" /></label>
        </div>
        <fieldset class="opts"><legend>{s.allowTitle}</legend>
          <label class="check"><input type="checkbox" name="aprint" checked />{s.aprint}</label>
          <label class="check"><input type="checkbox" name="acopy" checked />{s.acopy}</label>
          <label class="check"><input type="checkbox" name="amodify" />{s.amodify}</label>
          <label class="check"><input type="checkbox" name="aannot" checked />{s.aannot}</label>
        </fieldset>
        <p class="meta">{s.protectNote}</p>
        <div class="actions"><button type="button" class="btn" data-do="protect">{s.protectBtn}</button></div>
        <p class="note good" data-out hidden></p>
      </section>

      <section class="card panel tl" data-panel="info" hidden>
        <div class="row">
          <label>{s.title}<input name="title" autocomplete="off" /></label>
          <label>{s.author}<input name="author" autocomplete="off" /></label>
          <label>{s.subject}<input name="subject" autocomplete="off" /></label>
        </div>
        <div class="row">
          <label>{s.keywords}<input name="keywords" autocomplete="off" /></label>
          <label>{s.creator}<input name="creator" autocomplete="off" /></label>
          <label>{s.producer}<input name="producer" autocomplete="off" /></label>
        </div>
        <div class="actions">
          <button type="button" class="btn" data-do="save">{s.saveInfo}</button>
          <button type="button" class="btn alt" data-do="strip">{s.stripInfo}</button>
        </div>
        <h3>{s.annotsTitle}</h3>
        <div class="row">
          <label>{s.pagesField}<input name="apages" placeholder={s.rangePlaceholder} autocomplete="off" /></label>
          <button type="button" class="btn alt" data-do="annots">{s.annotsBtn}</button>
        </div>
      </section>

      <section class="card panel tl" data-panel="mix" hidden>
        <h3 class="exh"><svg class="ex" viewBox="0 0 64 40" aria-hidden="true"><rect x="8" y="5" width="26" height="30" rx="2"/><rect x="22" y="9" width="26" height="30" rx="2" class="b"/></svg>{s.overlayTitle}</h3>
        <div class="row">
          <label>{s.overlayFile}<input type="file" data-mixfile="overlay" accept="application/pdf,.pdf" /></label>
          <label>{s.opacityLabel}<input type="number" name="oopacity" min="1" max="100" value="100" /></label>
        </div>
        <fieldset class="opts"><legend>{s.whereLabel}</legend>
          <label class="check"><input type="radio" name="where" value="over" checked />{s.where_over}</label>
          <label class="check"><input type="radio" name="where" value="under" />{s.where_under}</label>
          <label class="check"><input type="checkbox" name="cycle" />{s.cycleLabel}</label>
        </fieldset>
        <div class="prev" data-prev="overlay" hidden></div>
        <div class="actions"><button type="button" class="btn alt" data-do="overlay">{s.overlayBtn}</button></div>
        <h3 class="exh"><svg class="ex" viewBox="0 0 64 40" aria-hidden="true"><rect x="3" y="8" width="12" height="24" rx="2"/><rect x="19" y="8" width="12" height="24" rx="2" class="b"/><rect x="35" y="8" width="12" height="24" rx="2"/><rect x="51" y="8" width="12" height="24" rx="2" class="b"/></svg>{s.altTitle}</h3>
        <div class="row">
          <label>{s.altFile}<input type="file" data-mixfile="alternate" accept="application/pdf,.pdf" /></label>
          <label class="check"><input type="checkbox" name="revb" />{s.revLabel}</label>
          <button type="button" class="btn alt" data-do="alternate">{s.altBtn}</button>
        </div>
        <div class="prev" data-prev="alternate" hidden></div>
        <h3 class="exh"><svg class="ex" viewBox="0 0 64 40" aria-hidden="true"><rect x="4" y="5" width="25" height="30" rx="2"/><rect x="35" y="5" width="25" height="30" rx="2" class="b"/><path d="M9 13h15M9 20h15M9 27h9M40 13h15M40 20h15M40 27h12" /></svg>{s.cmpTitle}</h3>
        <div class="row">
          <label>{s.cmpFile}<input type="file" data-mixfile="compare" accept="application/pdf,.pdf" /></label>
          <button type="button" class="btn alt" data-do="compare">{s.cmpBtn}</button>
        </div>
        <div class="diff" data-diff hidden></div>
      </section>

      <div class="card strip" data-strip hidden>
        <div class="strip-head">
          <p class="meta" data-striptitle></p>
          <div class="strip-nav" data-stripnav hidden>
            <button type="button" class="btn alt sm ib" data-stripprev aria-label={s.stripPrev}><Icon name="prev" size={15} /></button>
            <span class="meta" data-striprange></span>
            <button type="button" class="btn alt sm ib" data-stripnext aria-label={s.stripNext}><Icon name="next" size={15} /></button>
          </div>
        </div>
        <div class="strip-row" data-striprow></div>
      </div>
    </div>

    <dialog class="pview" data-pview>
      <div class="pv-bar">
        <strong data-pvtitle></strong>
        <span class="pv-hint">{s.zoomHint}</span>
        <button type="button" class="btn alt sm ib" data-pvout aria-label={s.zoomOut}><Icon name="minus" size={15} /></button>
        <span class="pv-pct" data-pvpct>100 %</span>
        <button type="button" class="btn alt sm ib" data-pvin aria-label={s.zoomIn}><Icon name="plus" size={15} /></button>
        <button type="button" class="btn alt sm" data-pvfit>{s.zoomFit}</button>
        <button type="button" class="btn sm" data-pvclose>{s.closeView}</button>
      </div>
      <div class="pv-stage" data-pvstage tabindex="0"><div class="pv-pan" data-pvpan></div></div>
    </dialog>

    <details class="card limits">
      <summary>{s.notPossibleTitle}</summary>
      <p>{s.notPossible}</p>
    </details>
  </div>
</ToolLayout>
<script>
  import '../../../../tools/pdf/pdf.ts';
</script>
<style is:global>
  .pdf { display: grid; gap: 18px; min-width: 0; }
  .pdf .dropzone { display: grid; justify-items: center; gap: 10px; padding: clamp(24px, 4vw, 40px); text-align: center; border-style: dashed; transition: padding .2s var(--ease); }
  .pdf .dropzone.over { border-color: var(--accent); }
  .pdf .dropzone.compact { padding: 14px 18px; gap: 6px; }
  .pdf .dropzone.compact .hint { display: none; }
  .pdf .big { margin: 0; font-family: var(--display, inherit); font-size: 1.1rem; }
  .pdf .picks { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  /* capture=environment only opens the camera on phones and tablets, so the button is for touch devices */
  .pdf .camera { display: none; }
  @media (pointer: coarse) { .pdf .camera { display: inline-flex; } }
  .pdf .hint { max-width: 60ch; margin: 0; }
  .pdf .pick { cursor: pointer; }
  .pdf .pick:focus-within { outline: 2px solid var(--accent-ink); outline-offset: 3px; }
