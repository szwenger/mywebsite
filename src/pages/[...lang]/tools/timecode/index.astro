---
import ToolLayout from '../../../../components/ToolLayout.astro';
import IconButton from '../../../../components/IconButton.astro';
import { langOf, toolPaths } from '../../../../i18n/tool-page';
import { s as strings } from '../../../../i18n/tools/timecode';
import { RATES } from '../../../../tools/timecode/logic';

export const getStaticPaths = toolPaths;
const lang = langOf(Astro.params);
const s = strings[lang];
---
<ToolLayout lang={lang} slug="timecode">
  <div class="tl" data-timecode data-s={JSON.stringify(s)}>
    <div class="card pane">
      <div class="row">
        <label>{s.rate}<select name="rate">{RATES.map((r) => <option value={r.id} selected={r.id === '25'}>{r.id} fps</option>)}</select></label>
        <label class="check"><input type="checkbox" name="drop" disabled /> {s.drop}</label>
      </div>
    </div>
    <div class="card pane">
      <h2 class="h">{s.calc}</h2>
      <div class="row">
        <label>{s.a}<input name="a" class="mono" value="00:00:00:00" autocomplete="off" spellcheck="false" inputmode="numeric" /></label>
        <label>&nbsp;<select name="op" aria-label={`${s.plus} / ${s.minus}`}><option value="1">{s.plus}</option><option value="-1">{s.minus}</option></select></label>
        <label>{s.b}<input name="b" class="mono" value="00:00:00:00" autocomplete="off" spellcheck="false" inputmode="numeric" /></label>
      </div>
      <div class="res">
        <span class="meta">{s.result}</span>
        <output class="mono big" data-result aria-live="polite"></output>
        <IconButton icon="copy" label={s.copy} data-copy />
      </div>
    </div>
    <div class="card pane">
      <h2 class="h">{s.convert}</h2>
      <div class="row">
        <label>{s.tc}<input name="tc" class="mono" value="00:00:00:00" autocomplete="off" spellcheck="false" inputmode="numeric" /></label>
        <label>{s.frames}<input name="frames" class="mono" value="0" autocomplete="off" inputmode="numeric" /></label>
        <label>{s.secs}<input name="secs" class="mono" value="0" autocomplete="off" inputmode="decimal" /></label>
      </div>
    </div>
    <p class="note" data-error role="status" hidden>{s.invalid}</p>
    <p class="meta">{s.note}</p>
  </div>
</ToolLayout>
<script>
  import '../../../../tools/timecode/timecode.ts';
</script>
<style>
  .h { margin: 0; font: 600 1rem/1.3 var(--display); }
  .big { font-size: 1.4rem; font-weight: 600; }
  .res { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
</style>
