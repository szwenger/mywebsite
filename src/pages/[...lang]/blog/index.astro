---
import Base from '../../../layouts/Base.astro';
import NoteItem from '../../../components/NoteItem.astro';
import PostCard from '../../../components/PostCard.astro';
import { LANGS, t, type Lang } from '../../../i18n/ui';
import { loadPosts } from '../../../lib/load-posts';
import { normalize, plainText } from '../../../lib/list';

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l === 'en' ? undefined : l } }));
}
const lang = (Astro.params.lang ?? 'en') as Lang;
const items = await loadPosts(lang);
// What the search looks through: title, tags and the start of the text.
const haystack = (p: (typeof items)[number]['post']) => normalize([p.title, ...(p.tags ?? []), plainText(p.body, 3000)].join(' '));
---
<Base lang={lang} title={`${t(lang, 'navBlog')} · Galuin`} description={t(lang, 'blogIntro')} current="blog">
  <section class="wrap page">
    <div class="column">
      <h1 class="section-title">{t(lang, 'navBlog')}</h1>
      <p class="meta intro">{t(lang, 'blogIntro')}</p>
      <div data-list data-per="10">
        <label class="search">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
          <input type="search" data-list-search placeholder={t(lang, 'searchPlaceholder')} aria-label={t(lang, 'searchLabel')} autocomplete="off" spellcheck="false" />
        </label>
        <div class="list">
          {items.map(({ post, Content }) => (
            <div data-item data-text={haystack(post)}>
              {post.kind === 'note'
                ? <NoteItem lang={lang} post={post}><Content /></NoteItem>
                : <PostCard lang={lang} post={post} />}
            </div>
          ))}
        </div>
        <p class="meta empty" data-list-empty hidden>{t(lang, 'noResults')}</p>
        <nav class="pager" data-list-pager hidden aria-label={t(lang, 'pagerLabel')} data-prev={t(lang, 'pagePrev')} data-next={t(lang, 'pageNext')} data-page={t(lang, 'pageWord')}></nav>
      </div>
    </div>
  </section>
</Base>
<script>
  import '../../../scripts/list';
</script>
<style>
  .page { padding-block: clamp(32px, 6vw, 64px) 0; }
  /* One reading column, centred like a post, so the list is not pushed to the left of a wide page. */
  .column { max-width: 760px; margin-inline: auto; }
  .intro { margin: -6px 0 24px; font-size: .95rem; }
  .search { display: flex; align-items: center; gap: 12px; height: 48px; padding: 0 16px; margin-bottom: 24px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); color: var(--muted); transition: border-color .15s; }
  .search:focus-within { border-color: var(--accent); }
  .search input { flex: 1; min-width: 0; height: 100%; border: 0; outline: 0; background: none; color: var(--fg); font: 400 1rem var(--font); }
  .search input::placeholder { color: var(--muted); }
  .list { display: grid; gap: 20px; }
  .empty { margin: 8px 0 0; }
</style>
