---
import Icon from '../../../components/Icon.astro';
import Base from '../../../layouts/Base.astro';
import VideoCard from '../../../components/VideoCard.astro';
import { LANGS, t, type Lang } from '../../../i18n/ui';
import { loadVideos } from '../../../lib/load-videos';
import { CHANNEL_URL } from '../../../lib/youtube.mjs';

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l === 'en' ? undefined : l } }));
}
const lang = (Astro.params.lang ?? 'en') as Lang;
const all = loadVideos();
const videos = all.filter((v) => !v.isShort);
const shorts = all.filter((v) => v.isShort);
const pager = { 'aria-label': t(lang, 'pagerLabel'), 'data-prev': t(lang, 'pagePrev'), 'data-next': t(lang, 'pageNext'), 'data-page': t(lang, 'pageWord') };
---
<Base lang={lang} title={`${t(lang, 'navVideos')} · Galuin`} description={t(lang, 'videosIntro')} current="videos">
  <section class="wrap page" data-density="large">
    <div class="head">
      <div>
        <h1 class="section-title">{t(lang, 'navVideos')}</h1>
        <p class="meta intro">{t(lang, 'videosIntro')}</p>
      </div>
      <div class="density" role="group" aria-label={t(lang, 'gridLabel')}>
        <button type="button" data-density-set="large" aria-pressed="true" aria-label={t(lang, 'gridLarge')} title={t(lang, 'gridLarge')}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><rect x="4" y="4" width="7" height="7" rx="1.5" /><rect x="13" y="4" width="7" height="7" rx="1.5" /><rect x="4" y="13" width="7" height="7" rx="1.5" /><rect x="13" y="13" width="7" height="7" rx="1.5" /></svg>
        </button>
        <button type="button" data-density-set="small" aria-pressed="false" aria-label={t(lang, 'gridSmall')} title={t(lang, 'gridSmall')}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><rect x="3.5" y="3.5" width="4.5" height="4.5" rx="1" /><rect x="9.75" y="3.5" width="4.5" height="4.5" rx="1" /><rect x="16" y="3.5" width="4.5" height="4.5" rx="1" /><rect x="3.5" y="9.75" width="4.5" height="4.5" rx="1" /><rect x="9.75" y="9.75" width="4.5" height="4.5" rx="1" /><rect x="16" y="9.75" width="4.5" height="4.5" rx="1" /><rect x="3.5" y="16" width="4.5" height="4.5" rx="1" /><rect x="9.75" y="16" width="4.5" height="4.5" rx="1" /><rect x="16" y="16" width="4.5" height="4.5" rx="1" /></svg>
        </button>
      </div>
    </div>

    {videos.length > 0 && (
      <section class="block" data-section="videos" aria-labelledby="videos-title" data-list data-per="12" data-key="v">
        <h2 class="section-title" id="videos-title">{t(lang, 'latestVideos')}</h2>
        <div class="grid">{videos.map((video) => <div data-item><VideoCard lang={lang} video={video} /></div>)}</div>
        <nav class="pager" data-list-pager hidden {...pager}></nav>
      </section>
    )}
    {shorts.length > 0 && (
      <section class="block" data-section="shorts" aria-labelledby="shorts-title" data-list data-per="12" data-key="s">
        <h2 class="section-title" id="shorts-title">{t(lang, 'shortsTitle')}</h2>
        <div class="grid shorts">{shorts.map((video) => <div data-item><VideoCard lang={lang} video={video} /></div>)}</div>
        <nav class="pager" data-list-pager hidden {...pager}></nav>
      </section>
    )}
    <p class="more"><a class="chip" href={CHANNEL_URL} rel="noopener">{t(lang, 'moreOnYouTube')} <Icon name="ext" size={14} /></a></p>
  </section>
</Base>
<script>
  import '../../../scripts/list';
  import '../../../scripts/density';
</script>
<style>
  .page { --vmin: 260px; --smin: 150px; padding-block: clamp(32px, 6vw, 64px) 0; }
  .page[data-density='small'] { --vmin: 160px; --smin: 100px; }
  .head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .intro { margin: -6px 0 24px; font-size: .95rem; }
  .density { display: flex; gap: 4px; padding: 4px; border: 1px solid var(--line); border-radius: 12px; }
  .density button { display: grid; place-items: center; width: 36px; height: 36px; border: 0; border-radius: 8px; background: none; color: var(--muted); cursor: pointer; transition: color .15s, background-color .15s, var(--press); }
  .density button:hover { color: var(--fg); }
  .density button[aria-pressed='true'] { background: var(--surface-2); color: var(--fg); }
  .block { margin-top: 48px; }
  .head + .block { margin-top: 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--vmin)), 1fr)); gap: 20px; }
  .grid.shorts { grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--smin)), 1fr)); }
  .more { margin: 48px 0 0; }
  .more a { padding: 8px 16px; font-size: .9rem; text-decoration: none; }
  .more a:hover { border-color: var(--accent); color: var(--accent-ink); }
  @media (max-width: 520px) { .grid { gap: 16px; } }
</style>
