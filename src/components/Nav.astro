---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { LANGS, localize, path, t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; current?: string; alternates?: Record<Lang, string> }
const { lang, current } = Astro.props;
const alternates = Astro.props.alternates ?? Object.fromEntries(LANGS.map((l) => [l, localize(Astro.url.pathname, l)])) as Record<Lang, string>;
const items = [['blog', 'navBlog'], ['videos', 'navVideos'], ['tools', 'navTools'], ['hardware', 'navHardware']] as const;
---
<header class="site-head">
  <div class="wrap bar">
    <a class="brand" href={path(lang, '/')}>
      <Image src={logo} alt="" width={30} height={30} densities={[1, 2]} loading="eager" />
      <span>Galuin</span>
    </a>
    <nav aria-label={t(lang, 'navLabel')}>
      <ul>
        {items.map(([id, key]) => (
          <li><a href={path(lang, `/${id}/`)} aria-current={current === id ? 'page' : undefined}>{t(lang, key)}</a></li>
        ))}
        <li><a href="https://www.twitch.tv/galuin" rel="noopener">{t(lang, 'navTwitch')}<span aria-hidden="true" class="ext">↗</span></a></li>
      </ul>
    </nav>
    <div class="controls">
      <div class="langs" role="group" aria-label={t(lang, 'langLabel')}>
        {LANGS.map((l) => l === lang
          ? <span aria-current="true" title={t(l, 'langName')}>{l.toUpperCase()}</span>
          : <a data-lang={l} href={alternates[l]} hreflang={l} lang={l} title={t(l, 'langName')} aria-label={t(l, 'langName')}>{l.toUpperCase()}</a>)}
      </div>
      <button type="button" class="theme" data-theme-toggle aria-label={t(lang, 'themeToggle')}>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="currentColor" /></svg>
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor" /><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></g></svg>
      </button>
    </div>
  </div>
</header>
<script>
  import { initTheme } from '../scripts/theme';
  initTheme();
</script>
<style>
  .site-head { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 28px; min-height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font: 800 1.05rem/1 var(--display); letter-spacing: -.01em; }
  .brand img { width: 30px; height: 30px; }
  nav { flex: 1; }
  ul { display: flex; gap: 4px; margin: 0; padding: 0; list-style: none; }
  nav a { display: block; padding: 8px 12px; border-radius: var(--radius-sm); text-decoration: none; color: var(--muted); font-weight: 500; font-size: .95rem; white-space: nowrap; transition: color .15s, background-color .15s; }
  nav a:hover { color: var(--fg); background: var(--surface); }
  nav a[aria-current='page'] { color: var(--fg); box-shadow: inset 0 -2px 0 var(--accent); border-radius: var(--radius-sm) var(--radius-sm) 0 0; }
  .ext { margin-left: 3px; font-size: .8em; }
  .controls { display: flex; align-items: center; gap: 10px; }
  .langs { display: flex; padding: 3px; border: 1px solid var(--line); border-radius: 99px; font-size: .74rem; font-weight: 600; letter-spacing: .02em; }
  .langs > * { padding: 4px 9px; border-radius: 99px; text-decoration: none; color: var(--muted); }
  .langs a:hover { color: var(--fg); }
  .langs [aria-current] { background: var(--surface-2); color: var(--fg); }
  .theme { display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid var(--line); border-radius: 99px; background: none; color: var(--fg); cursor: pointer; }
  .theme:hover { background: var(--surface); }
  :global([data-theme='dark']) .sun, :global([data-theme='light']) .moon { display: none; }

  /* Phones: brand + controls on top, the nav as a swipeable row underneath. */
  @media (max-width: 760px) {
    .bar { flex-wrap: wrap; gap: 0 12px; padding-top: 10px; }
    .brand { margin-right: auto; }
    nav { order: 3; flex-basis: 100%; overflow-x: auto; scrollbar-width: none; margin-inline: calc(-1 * var(--gutter)); padding: 6px var(--gutter) 4px calc(var(--gutter) - 10px); }
    nav a { padding: 8px 10px; }
  }
</style>
