---
import { icons, type IconName } from '../data/icons';
interface Props { name: IconName; size?: number }
const { name, size = 18 } = Astro.props;
---
<svg class="icon" viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={icons[name]} />
