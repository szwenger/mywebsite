---
import Icon from './Icon.astro';
import { path, t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; current?: string }
const { lang } = Astro.props;
const social = [
  ['YouTube', 'https://www.youtube.com/@Galuin'],
  ['Twitch', 'https://www.twitch.tv/galuin'],
  [t(lang, 'footerWork'), 'https://simon.zwenger.dev/'],
] as const;
---
<footer class="site-foot">
  <div class="wrap inner">
    <div class="sign">
      <p class="word" aria-hidden="true">Galuin<span>.</span></p>
      <p class="line">{t(lang, 'footerLine')}</p>
    </div>
    <ul class="social">
      <li><a href={path(lang, '/rss.xml')}><Icon name="rss" size={14} />RSS</a></li>
      {social.map(([label, href]) => <li><a href={href} rel="noopener">{label}<Icon name="ext" size={14} /></a></li>)}
    </ul>
    <div class="legal">
      <span>© {new Date().getFullYear()} Simon Zwenger</span>
      <a href={path(lang, '/impressum/')}>{t(lang, 'impressum')}</a>
      <a href={path(lang, '/privacy/')}>{t(lang, 'privacy')}</a>
      <a href={path(lang, '/licenses/')}>{t(lang, 'licenses')}</a>
    </div>
  </div>
</footer>
<style>
  .site-foot { margin-top: clamp(64px, 12vh, 120px); border-top: 1px solid var(--line); background: var(--surface); }
  .inner { display: grid; grid-template-columns: 1fr auto; gap: 24px 40px; padding-block: 40px 28px; }
  .word { margin: 0; font: 600 clamp(1.6rem, 3vw, 2.2rem)/1 var(--display); letter-spacing: -.03em; }
  .word span { color: var(--accent); }
  .line { margin: 12px 0 0; color: var(--muted); max-width: 32em; }
  .social { display: flex; flex-wrap: wrap; align-content: start; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .social a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border: 1px solid var(--line); border-radius: 99px; text-decoration: none; font-weight: 500; font-size: .9rem; transition: border-color .15s, color .15s; }
  .social a:hover { border-color: var(--accent); color: var(--accent-ink); }
  .social :global(.icon) { color: var(--muted); }
  .legal { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px 20px; padding-top: 20px; border-top: 1px solid var(--line); color: var(--muted); font-size: .85rem; }
  .legal a { padding-block: 6px; margin-block: -6px; text-decoration: none; } /* 22px text line, 34px tap target */
  .legal a:hover { color: var(--fg); text-decoration: underline; }
  @media (max-width: 640px) { .inner { grid-template-columns: 1fr; } }
</style>
