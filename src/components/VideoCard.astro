---
import { videoDate, type Video } from '../lib/load-videos';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; video: Video }
const { lang, video } = Astro.props;
---
<a class:list={['card video', { short: video.isShort }]} href={video.url} rel="noopener">
  <div class="thumb">
    {video.thumb && <img src={video.thumb} alt="" width="480" height="360" loading="lazy" />}
  </div>
  <div class="body">
    <h2>{video.title}</h2>
    <time class="meta" datetime={video.published}>{videoDate(video.published, lang)}</time>
  </div>
</a>
<style>
  .video { overflow: hidden; height: 100%; }
  .thumb { aspect-ratio: 16 / 9; background: var(--surface-2); border-bottom: 1px solid var(--line); overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  /* A Short is vertical: its thumbnail is the portrait frame, cropped from the centre of YouTube's 4:3 image. */
  .short .thumb { aspect-ratio: 9 / 16; }
  .body { padding: 16px 16px 20px; }
  h2 { margin: 0 0 8px; font: 600 .98rem/1.35 var(--font); letter-spacing: 0; display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  /* Small grid (videos page toggle): tighter card, smaller title. */
  :global([data-density='small']) .body { padding: 12px 12px 16px; }
  :global([data-density='small']) h2 { font-size: .85rem; margin-bottom: 4px; }
  :global([data-density='small']) .meta { font-size: .75rem; }
</style>
