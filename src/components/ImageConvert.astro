---
/** The converter body shared by the image and HEIC pages. `s` is the page's string table. */
interface Props { s: Record<string, string>; heic?: boolean; accept: string }
const { s, heic = false, accept } = Astro.props;
---
<div class="image" data-image data-heic={heic ? '' : undefined} data-strings={JSON.stringify(s)}>
  <div class="drop card" data-drop>
    <p class="big">{s.drop}</p>
    <p class="meta">{s.or}</p>
    <label class="btn pick">{s.browse}<input type="file" accept={accept} multiple data-file class="sr-only" /></label>
    <p class="meta hint">{s.hint}</p>
  </div>

  <div class="opts card" data-options>
    <label>{s.format}
      <select data-format>
        <option value="webp" selected>WebP</option>
        <option value="jpeg">JPG</option>
        <option value="png">PNG</option>
      </select>
    </label>
    <label>{s.quality} <output data-quality-out></output>
      <input type="range" min="10" max="100" step="5" value="85" data-quality />
    </label>
    <label>{s.maxW}<input type="number" min="1" inputmode="numeric" data-maxw /></label>
    <label>{s.maxH}<input type="number" min="1" inputmode="numeric" data-maxh /></label>
    <p class="meta note">{s.maxHint}</p>
  </div>

  <p class="warn" role="alert" data-error hidden></p>
  <p class="meta" role="status" data-status></p>

  <div class="work" data-work hidden>
    <div class="row end">
      <button type="button" class="btn alt" data-clear>{s.clear}</button>
      <button type="button" class="btn" data-all disabled>{s.all}</button>
    </div>
    <h2 class="sr-only">{s.list}</h2>
    <ul class="files" data-list></ul>
  </div>
</div>
<script>
  import '../tools/image/image.ts';
</script>
<style>
  .image { display: grid; gap: 18px; }
  .drop { display: grid; justify-items: center; gap: 8px; padding: clamp(24px, 4vw, 40px); text-align: center; border-style: dashed; }
  .drop.over { border-color: var(--accent); }
  .big { margin: 0; font-family: var(--font-display, inherit); font-size: 1.15rem; }
  .hint { max-width: 60ch; margin: 4px 0 0; }
  .pick { cursor: pointer; }
  .pick:focus-within { outline: 2px solid var(--accent); outline-offset: 3px; }
  .opts { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: end; padding: 16px 20px; }
  .opts label { display: grid; gap: 6px; font-size: .88rem; color: var(--muted); }
  .opts select, .opts input[type='number'] { padding: 9px 12px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface-2); color: var(--fg); font: inherit; font-size: .95rem; }
  .opts input[type='number'] { width: 11ch; }
  .opts input[type='range'] { width: 160px; accent-color: var(--accent); }
  .opts input[disabled] { opacity: .45; }
  .note { flex-basis: 100%; margin: 0; }
  .warn { margin: 0; padding: 9px 12px; border-radius: var(--radius-sm); border: 1px solid var(--line); background: var(--surface-2); font-size: .9rem; }
  .row { display: flex; flex-wrap: wrap; gap: 10px; }
  .row.end { justify-content: flex-end; }
  .btn.alt { background: transparent; color: var(--fg); border: 1px solid var(--line); box-shadow: none; }
  .btn[disabled] { opacity: .45; cursor: not-allowed; }
  .files { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 10px; }
  :global(.image .files .row) { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 8px 16px; padding: 12px 16px; }
  :global(.image .fname) { overflow-wrap: anywhere; }
  :global(.image .info) { margin: 0; }
  :global(.image .act) { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
  @media (max-width: 560px) {
    :global(.image .files .row) { grid-template-columns: 1fr; }
    :global(.image .act) { justify-content: flex-start; }
  }
</style>
