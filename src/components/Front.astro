---
import NoteItem from './NoteItem.astro';
import PostCard from './PostCard.astro';
import VideoCard from './VideoCard.astro';
import TwitchCard from './TwitchCard.astro';
import ToolsStrip from './ToolsStrip.astro';
import { path, t, type Lang } from '../i18n/ui';
import { dateLabel, loadPosts } from '../lib/load-posts';
import { loadVideos, videoDate } from '../lib/load-videos';
import { latestLong, pickLead } from '../lib/front';
interface Props { lang: Lang }
const { lang } = Astro.props;

const items = await loadPosts(lang);
const notes = items.filter(({ post }) => post.kind === 'note').slice(0, 3);
const videos = loadVideos();
const lead = pickLead(items.map(({ post }) => post), videos);
const postRow = latestLong(items.map(({ post }) => post), lead, 3);
const leadVideoId = lead?.type === 'video' ? lead.video.id : undefined;
const row = videos.filter((v) => !v.isShort && v.id !== leadVideoId).slice(0, 4);

const card = lead?.type === 'post'
  ? { href: path(lang, `/blog/${lead.post.slug}/`), img: lead.post.cover, title: lead.post.title, kicker: t(lang, 'leadPost'),
      date: dateLabel(lead.post.date, lang), iso: lead.post.date.toISOString().slice(0, 10), tags: lead.post.tags ?? [],
      textLang: lead.post.shownIn, fallback: lead.post.fallback }
  : lead?.type === 'video'
  ? { href: lead.video.url, img: lead.video.thumb, title: lead.video.title, kicker: t(lang, 'leadVideo'),
      date: videoDate(lead.video.published, lang), iso: lead.video.published, tags: [], textLang: undefined, fallback: false }
  : null;
---
<h1 class="sr-only">Galuin</h1>
<div class="wrap front">
  <div class:list={['top', { solo: !card }]}>
    {card && (
      <a class="card lead" data-section="lead" href={card.href} rel={lead?.type === 'video' ? 'noopener' : undefined}>
        <div class="media">
          {card.img && <img src={card.img} alt="" width="1280" height="720" loading="eager" />}
          {lead?.type === 'video' && <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg></span>}
        </div>
        <div class="body">
          <p class="kicker">
            <span>{card.kicker}</span>
            <time datetime={card.iso}>{card.date}</time>
            {card.fallback && <span class="chip" title={t(lang, 'fallbackNote')}>{card.textLang?.toUpperCase()}</span>}
          </p>
          <h2 lang={card.textLang}>{card.title}</h2>
          {card.tags.length > 0 && <ul class="tags">{card.tags.map((tag) => <li class="chip">#{tag}</li>)}</ul>}
        </div>
      </a>
    )}
    <section class="notes" data-section="notes" aria-labelledby="notes-title">
      <h2 class="section-title" id="notes-title">{t(lang, 'notesTitle')}</h2>
      <div class="stack">
        {notes.map(({ post, Content }) => <NoteItem lang={lang} post={post}><Content /></NoteItem>)}
      </div>
      <a class="more" href={path(lang, '/blog/')}>{t(lang, 'backToBlog')} <span aria-hidden="true">→</span></a>
    </section>
  </div>

  {postRow.length > 0 && (
    <section class="posts" data-section="posts" aria-labelledby="posts-title">
      <div class="row-head">
        <h2 class="section-title" id="posts-title">{t(lang, 'latestPosts')}</h2>
        <a class="more" href={path(lang, '/blog/')}>{t(lang, 'backToBlog')} <span aria-hidden="true">→</span></a>
      </div>
      <div class="post-grid">{postRow.map((post) => <PostCard lang={lang} post={post} />)}</div>
    </section>
  )}

  {row.length > 0 && (
    <section class="videos" data-section="videos" aria-labelledby="videos-title">
      <div class="row-head">
        <h2 class="section-title" id="videos-title">{t(lang, 'latestVideos')}</h2>
        <a class="more" href={path(lang, '/videos/')}>{t(lang, 'allVideos')} <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid">{row.map((video) => <VideoCard lang={lang} video={video} />)}</div>
    </section>
  )}

  <TwitchCard lang={lang} />
  <ToolsStrip lang={lang} />
</div>
<style>
  .front { display: grid; gap: clamp(40px, 6vw, 64px); padding-top: clamp(24px, 4vw, 44px); }

  .top { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: clamp(20px, 3vw, 32px); align-items: stretch; }
  .top.solo { grid-template-columns: minmax(0, 1fr); }
  .top.solo .stack { grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }

  /* The lead card stretches to the Notes column; the headline stays on top, the tags settle at the bottom edge. */
  .lead { overflow: hidden; display: flex; flex-direction: column; }
  .media { position: relative; aspect-ratio: 16 / 9; background: var(--surface-2); border-bottom: 1px solid var(--line); overflow: hidden; }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease); }
  @media (hover: hover) { .lead:hover .media img { transform: scale(1.03); } }
  .play {
    position: absolute; left: 18px; bottom: 18px; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%;
    background: var(--accent-strong); color: #fff; box-shadow: 3px 3px 0 var(--hard); padding-left: 3px;
  }
  .body { flex: 1; display: flex; flex-direction: column; padding: clamp(20px, 2.4vw, 28px); }
  .kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; margin: 0 0 12px; color: var(--muted); font-size: .85rem; }
  .kicker span:first-child { color: var(--accent-ink); font-weight: 600; }
  .lead h2 { margin: 0; font-size: clamp(1.35rem, 2.8vw, 2.1rem); overflow-wrap: anywhere; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin: auto 0 0; padding: 16px 0 0; list-style: none; }

  .notes .stack { display: grid; gap: 16px; }
  .notes :global(.note) { padding: 20px; }
  .notes :global(.note h2) { font-size: 1.02rem; }
  .notes :global(.note .prose) { font-size: .94rem; }
  .more { display: inline-flex; gap: 6px; margin-top: 16px; color: var(--muted); font-size: .9rem; font-weight: 500; text-decoration: none; }
  .more:hover { color: var(--accent-ink); }

  .row-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .row-head .more { margin: 0 0 16px; }
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .post-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }

  @media (max-width: 1000px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .top { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 520px) {
    .grid, .post-grid { grid-template-columns: minmax(0, 1fr); }
    .play { width: 46px; height: 46px; left: 14px; bottom: 14px; }
  }
</style>
